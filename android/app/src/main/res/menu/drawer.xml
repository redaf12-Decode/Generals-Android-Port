<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralsX @ui-redesign Android port dashboard-2026
     Navigation drawer items map to destinations that actually exist in this
     launcher. No placeholder entries for features that have no screen yet.

     GeneralsX @bugfix Android port 15/10/2026 Every destination is checkable
     here, and that is not decoration: Material 1.12.0's presenter refuses to
     select an item whose isCheckable() is false (NavigationMenuPresenter's
     adapter returns early), and NavigationMenuItemView only puts the row into
     the state_checked drawable state when the item is BOTH checkable and
     checked. Without these attributes the shell's setCheckedItem() calls, at
     build time and every time the drawer closes, were silently dropped, so the
     drawer could never show which page the user was on, and tapping a
     destination left every row looking the same. Section headers below are
     deliberately NOT checkable: they are labels, not destinations.

     GeneralsX @tweak Android port ui-organisation 16/10/2026 One entry per
     destination, in the order the work is actually done. The Tools page is an
     entry of its own now: it used to be missing, so opening it from the bottom
     rail left the     drawer highlighting "View logs", which is a different screen. The three
     launcher tools under it are direct entries because they are separate
     activities; the Tools page groups the same shortcuts together with the
     logging switches.

     Order: the dashboard (Home) first, then what the selected game needs
     (its folder and mod folder, then how it is rendered, then how it and the
     launcher look), then the tools, then the account, then support. The
     launch button is deliberately NOT in here: it stays on the dashboard,
     where it is the first thing on the screen. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dashboard -->
    <item
        android:id="@+id/nav_home"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_home"
        android:title="@string/nav_drawer_home"/>

    <!-- Game settings group -->
    <item
        android:id="@+id/nav_settings_header"
        android:title="@string/nav_drawer_settings"/>

    <!-- Storage first: which game folder is in use (and, for Zero Hour, the
         base-game archive folder), the mod folder, and the checks that decide
         whether the game will start at all. -->
    <item
        android:id="@+id/nav_folder"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_folder"
        android:title="@string/nav_drawer_game_folder"/>

    <item
        android:id="@+id/nav_graphics"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_display"
        android:title="@string/nav_tab_graphics"/>

    <item
        android:id="@+id/nav_interface"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_sliders"
        android:title="@string/nav_tab_interface"/>

    <!-- Tools group -->
    <item
        android:id="@+id/nav_tools_header"
        android:title="@string/nav_drawer_tools"/>

    <item
        android:id="@+id/nav_tools"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_terminal"
        android:title="@string/nav_tab_tools"/>

    <item
        android:id="@+id/nav_logs"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_doc"
        android:title="@string/setup_button_view_logs"/>

    <item
        android:id="@+id/nav_netdiag"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_wrench"
        android:title="@string/netdiag_title"/>

    <item
        android:id="@+id/nav_replay"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_play"
        android:title="@string/replaycheck_title"/>

    <!-- Community / account -->
    <item
        android:id="@+id/nav_online"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_account"
        android:title="@string/online_window_title"/>

    <!-- Support -->
    <item
        android:id="@+id/nav_help"
        android:checkable="true"
        android:icon="@drawable/ic_gzh_info"
        android:title="@string/nav_tab_help"/>

</menu>
