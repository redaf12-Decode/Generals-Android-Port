<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralsX @tweak Android port 08/11/2026 Adaptive launcher icon.
     Foreground/monochrome artwork: "Icon for Command & Conquer: Generals - Zero Hour" by
     pix0wl, from SteamGridDB (https://www.steamgriddb.com/icon/59649), described there as
     "Official" and extracted from the game's own EXE. The .ico was fetched from its CDN
     (https://cdn2.steamgriddb.com/icon/647a924986a26860d4813818f03672f5.ico), its 256x256
     frame extracted, and scaled so the emblem's farthest pixel stays inside the 66dp
     safe circle (33dp radius) of the 108dp canvas: no launcher mask cuts a wing. One PNG
     per density (mdpi..xxxhdpi), plus the monochrome layer Android 13+ themed icons use.
     minSdk 28, so this adaptive icon is the only one any supported Android shows.

     GeneralsX @tweak Android port 09/11/2026 The backdrop is now a translucent white
     (ic_launcher_background), so the launcher wallpaper shows through instead of the
     former opaque navy; the artwork and the manifest reference are unchanged. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
