<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GeneralsX @feature Android port launcher-ui-2026 08/09/2026 The
         launcher's Material 3 theme, applied per-Activity in
         AndroidManifest.xml (Setup / Folder Picker / Log Viewer /
         GeneralsOnline). The application-level Theme.NoTitleBar.Fullscreen
         stays the default for GeneralsZHActivity (the game surface), which
         must never pick any of this up.

         GeneralsX @feature Android port daylight-darkmode 16/10/2026 Was
         Theme.Material3.Dark - this launcher had always drawn on a dark
         ground - and is deliberately Theme.Material3.DayNight since the
         in-app Daylight/Darkmode setting (ThemeHelper, Interface tab): the
         palette split lives in res/values/colors.xml (daylight) and
         res/values-night/colors.xml (darkmode, the original set verbatim),
         and which half resolves is decided by the effective night mode -
         the system's, or the launcher's own override applied through
         Configuration.uiMode in every launcher Activity's
         attachBaseContext(). The DayNight parent also keeps Material's own
         internal widget shading (switch tracks, slider tracks, ripple
         bounds) coherent in both halves, which a fixed-Dark parent cannot
         do once a light palette is in values/. -->
    <style name="Theme.GeneralsZHSettings" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- M3 colour roles (both palettes define the same names) -->
        <item name="colorPrimary">@color/gzh_primary</item>
        <item name="colorOnPrimary">@color/gzh_on_primary</item>
        <item name="colorPrimaryContainer">@color/gzh_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/gzh_on_primary_container</item>
        <item name="colorSecondary">@color/gzh_secondary</item>
        <item name="colorOnSecondary">@color/gzh_on_secondary</item>
        <item name="colorSecondaryContainer">@color/gzh_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/gzh_on_secondary_container</item>
        <item name="colorTertiary">@color/gzh_tertiary</item>
        <item name="colorOnTertiary">@color/gzh_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/gzh_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/gzh_on_tertiary_container</item>
        <item name="colorError">@color/gzh_error</item>
        <item name="colorOnError">@color/gzh_on_error</item>
        <item name="colorErrorContainer">@color/gzh_error_container</item>
        <item name="colorOnErrorContainer">@color/gzh_on_error_container</item>
        <item name="colorSurface">@color/gzh_surface</item>
        <item name="colorOnSurface">@color/gzh_on_surface</item>
        <item name="colorSurfaceVariant">@color/gzh_surface_container_high</item>
        <item name="colorOnSurfaceVariant">@color/gzh_on_surface_variant</item>
        <item name="colorOutline">@color/gzh_outline</item>
        <item name="colorOutlineVariant">@color/gzh_outline_variant</item>
        <item name="colorSurfaceContainerLow">@color/gzh_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/gzh_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/gzh_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/gzh_surface_container_highest</item>
        <item name="android:colorBackground">@color/gzh_background</item>
        <item name="colorOnBackground">@color/gzh_on_surface</item>

        <!-- Framework slots the plain android.* widgets (AlertDialog, Toast
             anchors, ListView, EditText) still read. -->
        <item name="colorPrimaryDark">@color/gzh_primary_dark</item>
        <item name="colorAccent">@color/gzh_accent</item>
        <item name="android:windowBackground">@color/gzh_background</item>
        <item name="android:textColorPrimary">@color/gzh_on_surface</item>
        <item name="android:textColorSecondary">@color/gzh_on_surface_variant</item>
        <item name="android:textColorTertiary">@color/gzh_on_surface_faint</item>
        <item name="android:textColorHint">@color/gzh_on_surface_faint</item>
        <item name="android:textColorHighlight">@color/gzh_primary_container</item>

        <!-- The launcher's own ripple for accent-coloured controls, from the
             palette's primary. The accent overlays (themes_accents.xml)
             re-point it, so both the drawer and the bottom rail follow the
             Interface tab's accent. -->
        <item name="itemRippleColor">@color/gzh_ripple_primary</item>

        <!-- Edge-to-edge: targetSdk 35 draws behind the bars anyway, and
             InsetUtil.applySafeInsets() pads the content out from under
             them. Painting the bars transparent lets the page colour run
             all the way to the physical edges instead of banding. The
             light/dark content-colour flag resolves through a bool resource
             rather than being hard-coded here, so the daylight palette gets
             dark status-bar icons and the darkmode palette light ones
             without re-declaring this whole style per mode. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/gzh_light_system_bars</item>

        <!-- Material dialogs use the activity's already-accented palette.
             Keep only the dialog-specific colours in the overlay; do not
             hard-code colorPrimary/colorSurface there, otherwise it would
             reset the selected accent back to the base violet palette. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.GeneralsZH.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.GeneralsZH.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.GeneralsZH.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:textColorPrimary">@color/gzh_on_surface</item>
        <item name="android:textColorSecondary">@color/gzh_on_surface_variant</item>
    </style>

    <!-- SetupActivity/LogViewerActivity still build a couple of plain
         android.app.AlertDialogs (single-choice language / render-backend
         pickers, "clear logs?"). Give those the same ground and text
         colours so they don't flash a light-grey Holo box on a near-black
         screen. -->
    <style name="Theme.GeneralsZH.AlertDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/gzh_dialog_background</item>
        <item name="android:colorAccent">@color/gzh_primary</item>
        <item name="android:textColorPrimary">@color/gzh_on_surface</item>
        <item name="android:textColorSecondary">@color/gzh_on_surface_variant</item>
        <item name="android:textColorAlertDialogListItem">@color/gzh_on_surface</item>
    </style>

    <!-- Applied with a ContextThemeWrapper where an outlined text field is
         wanted: TextInputLayout resolves its style from ?attr/textInputStyle,
         so swapping that attribute is the way to pick OutlinedBox for a
         view built in code rather than inflated from XML. -->
    <style name="ThemeOverlay.GeneralsZH.OutlinedField" parent="">
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <!-- The navigation drawer's item ripple. Material 1.12.0's NavigationView
         has no setItemRippleColor() (NavigationBarView, the bottom rail, is the
         one that does), but it does resolve ?attr/itemRippleColor, so a
         ContextThemeWrapper over this overlay is how the drawer's rows get the
         launcher's own ripple instead of the theme default, while keeping
         Material's checked-state highlight on the item background. -->
    <style name="ThemeOverlay.GeneralsZH.NavigationDrawer" parent="">
        <item name="itemRippleColor">@color/gzh_ripple_primary</item>
    </style>

    <!-- Status-bar signal for the framework flag above: true in daylight,
         false in darkmode, flipped by values-night/themes.xml. -->
    <bool name="gzh_light_system_bars">true</bool>
</resources>
