    <!-- GeneralsX @feature Android port accent-colors 16/10/2026 The DAYLIGHT
         halves of the alternate accent palettes offered by the launcher's
         Interface -> Accent picker (ThemeHelper). The default - violet, the
         gzh_* roles in values/colors.xml - is NOT here: it needs no overlay,
         the base theme already resolves to it.

         Each palette is not just the accent roles: it carries the WHOLE
         surface ladder tinted by the accent's hue (background -> surface ->
         the four container steps, outline pair, and the M3 secondary pair)
         so picking an accent recolours the whole interface, not just the
         buttons. Daylight values are pale pastel washes of the hue - the
         surfaces stay bright and the neutral dark text roles from
         values/colors.xml keep contrast, so nothing below is a text colour.
         values-night/accent_colors.xml carries the darkmode halves of exactly
         these names - keep the two lists in sync.

         Colour roles per accent X (suffix):
           _primary/_on_primary/_container/_on_container/_ripple - accent itself
           _background/_surface/_container_low/_container/_container_high/
             _container_highest - the tinted surface ladder
           _outline/_outline_variant - hairlines and borders
           _secondary/_on_secondary/_secondary_container/
             _on_secondary_container - the muted M3 companion pair
         Tertiary (danger) and error stay neutral on purpose: a red accent
         must not blur the red danger semantics. -->

    <!-- Blue -->
    <color name="gzh_accent_blue_primary">#1565C0</color>
    <color name="gzh_accent_blue_on_primary">#FFFFFF</color>
    <color name="gzh_accent_blue_container">#D3E4FF</color>
    <color name="gzh_accent_blue_on_container">#001C38</color>
    <color name="gzh_accent_blue_ripple">#331565C0</color>
    <color name="gzh_accent_blue_background">#F9F9FE</color>
    <color name="gzh_accent_blue_surface">#FCFCFF</color>
    <color name="gzh_accent_blue_container_low">#F3F3FA</color>
    <color name="gzh_accent_blue_container_surface">#EEEDF6</color>
    <color name="gzh_accent_blue_container_high">#E8E6F1</color>
    <color name="gzh_accent_blue_container_highest">#E3E1EC</color>
    <color name="gzh_accent_blue_outline">#7E778C</color>
    <color name="gzh_accent_blue_outline_variant">#DBD4E2</color>
    <color name="gzh_accent_blue_secondary">#5F5A70</color>
    <color name="gzh_accent_blue_on_secondary">#FFFFFF</color>
    <color name="gzh_accent_blue_secondary_container">#E4E2F2</color>
    <color name="gzh_accent_blue_on_secondary_container">#1B1B26</color>

