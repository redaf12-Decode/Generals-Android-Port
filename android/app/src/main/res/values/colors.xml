<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GeneralsX @feature Android port daylight-darkmode 16/10/2026 Design
         tokens for the launcher (Setup / GeneralsOnline / Log Viewer /
         Folder Picker). This file is the DAYLIGHT half of a two-palette set:
         the darkmode palette lives in res/values-night/colors.xml and keeps
         the near-black Material 3 set the launcher shipped with. Both halves
         define the same names; which one the widgets read is decided purely
         by the resolved night mode (the system's, or the in-app Daylight /
         Darkmode choice written by ThemeHelper and applied through
         Configuration.uiMode in every launcher Activity).

         Light roles follow the same Material 3 surface-container ladder as
         the dark set, mirrored: a soft lavender-white ground, containers that
         step slightly darker as they stack, the baseline purple-40 primary
         (the daylight counterpart of the dark palette's lavender tone-80) for
         headings/active state, and muted brick red for destructive actions.

         GeneralsZHActivity (the game surface itself) never references any of
         these - it stays on its own plain fullscreen theme. -->

    <!-- Ground + surface ladder (M3 surface container roles) -->
    <color name="gzh_background">#FAF8FC</color>
    <color name="gzh_surface">#FDFBFF</color>
    <color name="gzh_surface_container_low">#F5F2F8</color>
    <color name="gzh_surface_container">#F0EDF4</color>
    <color name="gzh_surface_container_high">#EAE6F0</color>
    <color name="gzh_surface_container_highest">#E5E1EA</color>

    <!-- Content on those surfaces -->
    <color name="gzh_on_surface">#1B1A22</color>
    <color name="gzh_on_surface_variant">#484554</color>
    <!-- The faintest tier still has to clear WCAG AA (4.5:1) at 12sp against
         gzh_surface_container, which a lighter grey did not. -->
    <color name="gzh_on_surface_faint">#726F80</color>
    <color name="gzh_outline">#7A7689</color>
    <color name="gzh_outline_variant">#DDD9E5</color>

    <!-- Primary: the lavender accent's daylight tone (headings, active nav
         item, selected segment, hero action). -->
    <color name="gzh_primary">#6750A4</color>
    <color name="gzh_on_primary">#FFFFFF</color>
    <color name="gzh_primary_container">#E8DEFF</color>
    <color name="gzh_on_primary_container">#21005D</color>
    <!-- Kept for the themes.xml colorPrimaryDark slot (pre-API-23 status bar). -->
    <color name="gzh_primary_dark">#FAF8FC</color>
    <color name="gzh_accent">#6750A4</color>

    <!-- Secondary: a desaturated companion for tonal chips/containers. -->
    <color name="gzh_secondary">#625B71</color>
    <color name="gzh_on_secondary">#FFFFFF</color>
    <color name="gzh_secondary_container">#E8DEF8</color>
    <color name="gzh_on_secondary_container">#1D192B</color>

    <!-- Tertiary: the muted brick used for destructive / "clear" actions. -->
    <color name="gzh_tertiary">#9C4139</color>
    <color name="gzh_on_tertiary">#FFFFFF</color>
    <color name="gzh_tertiary_container">#FFDAD6</color>
    <color name="gzh_on_tertiary_container">#410E0B</color>

    <color name="gzh_error">#B3261E</color>
    <color name="gzh_on_error">#FFFFFF</color>
    <color name="gzh_error_container">#F9DEDC</color>
    <color name="gzh_on_error_container">#410E0B</color>

    <!-- Disabled state (M3: 38% of on-surface for content, 12% for containers) -->
    <color name="gzh_on_surface_disabled">#611B1A22</color>
    <color name="gzh_container_disabled">#1F1B1A22</color>
    <color name="gzh_ripple_light">#1F1B1A22</color>
    <!-- The launcher's own ripple for accent-coloured controls: the daylight
         primary at Material's 0x33 alpha. The accent-overlay half of the
         palette pairs this with gzh_accent_*_ripple. -->
    <color name="gzh_ripple_primary">#336750A4</color>

    <!-- GeneralsX @feature Android port game-folder-integrity-check 07/09/2026
         Semantic status colours for the game-folder validity line (see
         refreshStatus() in SetupActivity.java) - retuned for the light ground
         above so they stay legible without shouting. -->
    <color name="gzh_status_ok">#217A3F</color>
    <color name="gzh_status_warn">#8F6200</color>
    <color name="gzh_status_error">#B3261E</color>

    <!-- GeneralsX @feature Android port daylight-darkmode 16/10/2026 The
         dashboard's own background wash (bg_dashboard.xml) and the seam
         texture it layers (bg_dashboard_pattern.xml). Named colours rather
         than literals in the drawables so the daylight dashboard is a light
         page with light cards on it, instead of near-black behind light
         cards; values-night keeps the original dark wash. The scrim is the
         gradient that keeps the app bar readable from the top edge, so in
         daylight it is simply absent (nothing to darken). -->
    <color name="gzh_dashboard_top">#FAF8FC</color>
    <color name="gzh_dashboard_mid">#F7F4FB</color>
    <color name="gzh_dashboard_bottom">#F1ECF7</color>
    <color name="gzh_dashboard_scrim">#00000000</color>
    <color name="gzh_dashboard_seam">#6750A4</color>
</resources>
