<resources>
    <!-- GeneralsX @feature Android port accent-colors 16/10/2026 Per-accent
         theme overlays for the launcher's Interface -> Accent picker
         (ThemeHelper.applyAccentTheme()). Each overlay re-points the Material
         3 primary slots at one of the alternate palettes in
         accent_colors.xml; the night halves of those colours resolve through
         values-night, so one overlay per accent covers BOTH daylight and
         darkmode. The default violet needs no overlay - the base
         Theme.GeneralsZHSettings already resolves to it.

         The overlays also re-point the surface ladder (colorSurface, the
         four colorSurfaceContainer* tones,
         android:colorBackground/android:windowBackground, colorSurfaceVariant)
         plus the outline pair and the secondary pair, so a picked accent
         recolours the WHOLE interface, not just the buttons: pale pastel
         washes of the hue in daylight, near-black hue washes in darkmode, both
         from the same overlay through values-night. Text/foreground roles (the
         on_surface ladder, status colours) and the danger/error pair stay
         neutral on purpose - they read against every hue, and a red accent
         must not blur the red danger semantics.

         itemRippleColor is here too: the drawer and the bottom rail read it
         from the theme, so their ripples follow the picked accent instead of
         staying violet (the base themes.xml value). Every item follows the
         base theme's own mapping - see values/themes.xml. -->

    <style name="ThemeOverlay.GeneralsZH.Accent.Blue" parent="">
        <item name="colorPrimary">@color/gzh_accent_blue_primary</item>
        <item name="colorOnPrimary">@color/gzh_accent_blue_on_primary</item>
        <item name="colorPrimaryContainer">@color/gzh_accent_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/gzh_accent_blue_on_container</item>
        <item name="colorAccent">@color/gzh_accent_blue_primary</item>
        <item name="colorPrimaryDark">@color/gzh_accent_blue_on_container</item>
        <item name="android:textColorHighlight">@color/gzh_accent_blue_container</item>
        <item name="itemRippleColor">@color/gzh_accent_blue_ripple</item>
        <item name="colorSecondary">@color/gzh_accent_blue_secondary</item>
        <item name="colorOnSecondary">@color/gzh_accent_blue_on_secondary</item>
        <item name="colorSecondaryContainer">@color/gzh_accent_blue_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/gzh_accent_blue_on_secondary_container</item>
        <item name="android:colorBackground">@color/gzh_accent_blue_background</item>
        <item name="android:windowBackground">@color/gzh_accent_blue_background</item>
        <item name="colorSurface">@color/gzh_accent_blue_surface</item>
        <item name="colorSurfaceContainerLow">@color/gzh_accent_blue_container_low</item>
        <item name="colorSurfaceContainer">@color/gzh_accent_blue_container_surface</item>
