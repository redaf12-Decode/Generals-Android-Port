<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralsX @tweak Android port icon-family 18/10/2026 Outline glyph on the shared 24dp grid
     (2-unit stroke, round caps/joins, content inside 3..21). The open jaw, the shaft and the
     rounded handle are one stroke; the old version was a single solid blob with a hole, which at
     16dp in the drawer closed into a black square. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- translateY only: the jaw's own geometry starts at y=2.0, and a 2-unit stroke on it would
         paint a pixel above the shared 2..22 box. Moving the path down half a unit keeps the
         stroke width exactly 2 (a scaled group would have thinned it). -->
    <group android:translateY="0.6">
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.2-3.2a6 6 0 0 1-7.7 7.7l-6.4 6.4a2.3 2.3 0 0 1-3.2-3.2l6.4-6.4a6 6 0 0 1 7.7-7.7z" />
    </group>
</vector>
