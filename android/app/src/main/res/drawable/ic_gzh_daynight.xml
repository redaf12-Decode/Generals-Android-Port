<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralsX @tweak Android port icon-family 18/10/2026 Outline glyph on the shared 24dp grid
     (2-unit stroke, round caps/joins, content inside 3..21). A circle with one half filled: the
     daylight/darkmode toggle every launcher uses, and the only reading of this idea that survives
     24dp. The previous sun-and-moon pair put a 2.8-unit disc and three 1.4-unit nubs on the left
     and a crescent on the right, which at 16dp in a card header became five unrelated specks. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12 3a9 9 0 0 1 0 18a9 9 0 0 1 0-18" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12 3.6a8.4 8.4 0 0 1 0 16.8z" />
</vector>
