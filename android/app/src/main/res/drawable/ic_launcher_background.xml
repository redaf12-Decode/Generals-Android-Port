<?xml version="1.0" encoding="utf-8"?>
<!-- GeneralsX @tweak Android port 09/11/2026 Backdrop of the launcher icon: a translucent white
     (owner's request), a soft lighter centre fading to a more see-through edge, so the launcher's
     wallpaper shows through and the emblem sits on a frosted white instead of the former opaque
     navy. The alphas are white, not colour, so the backdrop reads the same under any mask shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="64"
                android:startColor="#B3FFFFFF"
                android:endColor="#66FFFFFF" />
        </aapt:attr>
    </path>
</vector>
