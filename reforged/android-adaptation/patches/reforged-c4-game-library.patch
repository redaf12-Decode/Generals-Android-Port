+//-------------------------------------------------------------------------------------------------
+/** (C5 touch graft, from the GeneralsX Android port) Answer, without sending anything, the
+	* question winProcessMouseEvent() answers for itself every time it runs: which window does
+	* a press at these coordinates belong to? A NULL result means the press belongs to the game
+	* world. Touch input needs this to decide whether a finger position is a point on the
+	* battlefield at all -- a test that only looked for a leaf push button would call every
+	* dialog that is not made of buttons "battlefield", and drag an armed command's radius
+	* decal around the map behind it.
+	* This manager has no findWindowUnderMouse pass to share; its own routing primitives are
+	* the mouse captor, the grab window and getWindowUnderCursor, so the answer is composed
+	* from those, with the retail WIN_STATUS_NO_INPUT filter (and its combo-box exception)
+	* applied on top. */
+//-------------------------------------------------------------------------------------------------
+GameWindow *GameWindowManager::getWindowForInputAt( Int x, Int y )
+{
+	if( m_mouseCaptor )
+		return m_mouseCaptor->winPointInChild( x, y );
+
+	if( m_grabWindow )
+		return m_grabWindow;
+
+	GameWindow *window = getWindowUnderCursor( x, y, TRUE );
+	if( window && BitTest( window->m_status, WIN_STATUS_NO_INPUT ) )
+	{
+		if( window->winGetParent() && BitTest( window->winGetParent()->winGetStyle(), GWS_COMBO_BOX ) )
+			window = window->winGetParent();
+		else
+			window = NULL;
+	}
+	return window;
+}
