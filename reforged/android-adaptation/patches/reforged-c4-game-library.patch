+// ---- The post chain (v1.30 step 1, 2026-11-20) -------------------------------------------
+// The decision, the composite and its replay.  The picture this makes: the world draws
+// into the scene target, and at the game's Finish_Scene moment -- the world finished,
+// the health bars and the interface not yet drawn -- one pass brings the scene down to
+// the back buffer through dx11post's tone curve and grade.  Bloom's contribution is
+// zero by construction: the tone pass has no glow input, whatever intensity the game
+// stored.  Bloom proper is Step 2; fxaa and sharpen are Step 3; nothing else in the
+// chain runs yet, and a chain that asks only for those still arms the composite on the
+// tiers whose definition keeps tone/grade (SdlPostTier).
+//
+// Step 2 (2026-11-20): bloom proper.  On the full tier over the float scene, the
+// finish first records dx11post's bloom sequence (the plan in SdlPostBloomPlan):
+// the bright-pass extract and the widening blur pairs over two quarter-resolution
+// half-float targets, then the composite -- the tone pass with the glow added at
+// the stored intensity, the wide body under InternalHdr.  An intensity of zero
+// records no bloom passes: the composite alone, graded, exactly as dx11post's
+// own intensity-zero branch.  The reduced tier never arms bloom (the tier keeps
+// it subtracted there), and off the full tier the frame is step 1's, unchanged.
+//
+// Step 4 (2026-11-20): the mid-scene half.  At the game's Occlude_Scene moment
+// -- the world drawn, the particles not yet -- the frame resolves the scene's
+// depth into its own snapshot and, on the full tier, records the chain's AO
+// over a copy of the scene (multiplied in) and the MapLight haze over that
+// (blended), from the values the bridge hands Run_Post_Occlude.  The finish
+// plan reads the frame's occlusion back: an AO that ran mid-scene is stripped
+// from it, and one that was refused there runs at the finish over the same
+// resolved depth, as dx11post's Finish runs it then.  The reduced tier
+// subtracts both, as it subtracts bloom.
+
+void SdlGpuFrame::Configure_Post(const int * chain, unsigned chain_length, const char * chain_text)
+{
+	const char * driver = (GpuDevice != NULL) ? SDL_GetGPUDeviceDriver(GpuDevice) : NULL;
+	// The identity the tier gate parses is the device NAME (see WeakGpu's
+	// note in PosixDevice9SunShadow.cpp): the driver string is the backend's
+	// name ("vulkan") and never a model.
+	const char * device_name = NULL;
+	if (GpuDevice != NULL) {
+		const SDL_PropertiesID props = SDL_GetGPUDeviceProperties(GpuDevice);
+		if (props) {
+			device_name = SDL_GetStringProperty(props, SDL_PROP_GPU_DEVICE_NAME_STRING, NULL);
+		}
+	}
+	const char * identity = device_name ? device_name : driver;
+	const bool capable = GpuDevice != NULL && SDL_GPUTextureSupportsFormat(GpuDevice,
+		SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT, SDL_GPU_TEXTURETYPE_2D,
+		SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER);
+	const bool weak = SdlGpuIdentity::Device_Is_Known_Weak(device_name, driver);
+	int env_float = -1;
+	if (const char * value = getenv("ZH_POST_FLOAT")) {
+		if (value[0] == '0') {
+			env_float = 0;
+		}
+		else if (value[0] == '1') {
+			env_float = 1;
+		}
+	}
+	int env_tier = -1;
+	if (const char * value = getenv("ZH_POST_TIER")) {
+		if (strcmp(value, "off") == 0) {
+			env_tier = SdlPostTier::TIER_OFF;
+		}
+		else if (strcmp(value, "reduced") == 0) {
+			env_tier = SdlPostTier::TIER_REDUCED;
+		}
+		else if (strcmp(value, "full") == 0) {
+			env_tier = SdlPostTier::TIER_FULL;
+		}
+	}
+	// The chain's facts, and the chain itself, kept for Run_Post_Chain's plan
+	// (v1.30 step 3): through step 2 only two of the facts were read here, and
+	// a chain of passes alone armed nothing.
+	const bool chain_requested = chain != NULL && chain_length > 0;
+	const bool chain_starts_bloom = chain_requested
+		&& chain[0] == SdlPostPlan::EFFECT_BLOOM;
+	bool chain_has_non_ao = false;
+	bool chain_has_ao = false;
+	PostChainLength = 0;
+	if (chain != NULL) {
+		const unsigned kept = chain_length < SdlPostPlan::CHAIN_LIMIT
+			? chain_length : SdlPostPlan::CHAIN_LIMIT;
+		for (unsigned index = 0; index < kept; ++index) {
+			PostChainEffects[index] = chain[index];
+			if (chain[index] != SdlPostPlan::EFFECT_AO) {
+				chain_has_non_ao = true;
+			}
+			else {
+				chain_has_ao = true;
+			}
+		}
+		PostChainLength = kept;
+	}
+	const SdlPostTier::Decision decision = SdlPostTier::Decide(chain_requested, chain_starts_bloom,
+		chain_has_non_ao, chain_has_ao, capable, weak, env_float, env_tier);
+	const bool was_armed = PostArmed;
+	const unsigned int was_format = SceneFormat;
+	const bool was_bloom = PostBloomArmed;
+	const bool was_ao = PostOccludeArmed
+		&& (PostEffectArmedMask & SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_AO)) != 0;
+	const bool was_haze = PostHazeArmed;
+	const std::string was_plan = PostPlanText;
+	PostTierState = decision.Tier;
+	PostFloatScene = decision.FloatScene;
+	SceneFormat = decision.FloatScene
+		? (unsigned int)SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT : (unsigned int)BACK_BUFFER_FORMAT;
+	PostArmed = decision.Arm;
+	PostCompositeStep = decision.Composite;
+	// The pipelines are built now, not at the first frame: a chain whose programs
+	// would not build is never armed, and the game keeps the picture it had.
+	// The composite's programs are part of every arming, passes-only chains
+	// included: Present's bring-down speaks through them when a frame draws
+	// the scene and never finishes it.
+	if (PostArmed && !Create_Post_Pipelines()) {
+		fprintf(stderr, "post: the composite's programs would not build; the chain stays off\n");
+		PostArmed = false;
+		PostCompositeStep = false;
+	}
+	PostChainStartsBloom = chain_starts_bloom;
+	// Bloom arms on top of the composite (v1.30 step 2): the full tier, the float
+	// scene and a chain that starts with bloom -- the tier decision's own terms.
+	// Its programs are per-effect isolated, as the committee asked: a bloom
+	// program that would not build costs the glow, never the composite.
+	PostBloomArmed = PostCompositeStep && PostTierState == SdlPostTier::TIER_FULL
+		&& PostFloatScene && chain_starts_bloom;
+	if (PostBloomArmed && !Create_Bloom_Pipelines()) {
+		fprintf(stderr, "post: bloom's programs would not build; bloom stays off, the composite runs\n");
+		PostBloomArmed = false;
+	}
+	// Bloom's targets follow the scene target's rule: made while armed, let go
+	// through the batch when not.  A resize remakes them with the targets.
+	if (!PostBloomArmed && BloomTargets[0] != NULL) {
+		Release_After_Batch(BloomTargets[0], NULL);
+		Release_After_Batch(BloomTargets[1], NULL);
+		BloomTargets[0] = BloomTargets[1] = NULL;
+	}
+	if (PostBloomArmed && BloomTargets[0] == NULL && GpuDevice != NULL && BackWidth > 0) {
+		SDL_GPUTextureCreateInfo info;
+		SDL_zero(info);
+		info.type = SDL_GPU_TEXTURETYPE_2D;
+		info.format = SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT;
+		info.usage = SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER;
+		info.width = BackWidth / 4 > 0 ? BackWidth / 4 : 1;
+		info.height = BackHeight / 4 > 0 ? BackHeight / 4 : 1;
+		info.layer_count_or_depth = 1;
+		info.num_levels = 1;
+		info.sample_count = SDL_GPU_SAMPLECOUNT_1;
+		BloomTargets[0] = SDL_CreateGPUTexture(GpuDevice, &info);
+		BloomTargets[1] = SDL_CreateGPUTexture(GpuDevice, &info);
+		if (BloomTargets[0] == NULL || BloomTargets[1] == NULL) {
+			fprintf(stderr, "post: the bloom targets would not be made (%s); bloom stays off\n",
+				SDL_GetError());
+			if (BloomTargets[0] != NULL) Release_After_Batch(BloomTargets[0], NULL);
+			if (BloomTargets[1] != NULL) Release_After_Batch(BloomTargets[1], NULL);
+			BloomTargets[0] = BloomTargets[1] = NULL;
+			PostBloomArmed = false;
+		}
+	}
+	// The chain passes' programs (v1.30 step 3), per-effect isolated like
+	// bloom's: the mask names what may run.  The copy bit rides the composite's
+	// pipelines, built above; a "copy" in the chain is a pass like the others.
+	PostEffectArmedMask = 0;
+	if (PostArmed) {
+		if (PostCopyPipeline != NULL) {
+			PostEffectArmedMask |= SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_COPY);
+		}
+		PostEffectArmedMask |= Create_Chain_Pipelines();
+	}
+	// The plan for the chain as configured, and the chain targets it routes
+	// through.  A plan of nothing -- a passes-only chain whose every program
+	// failed -- disarms outright: the frame keeps the path it had.
+	SdlPostPlan::Plan plan = SdlPostPlan::Make_Plan(PostChainEffects, PostChainLength,
+		PostCompositeStep, PostEffectArmedMask, false);
+	if (PostArmed && plan.Count == 0) {
+		PostArmed = false;
+		PostCompositeStep = false;
+	}
+	PostUsesChainTargets = plan.UsesChainTargets;
+	if (!PostUsesChainTargets && ChainTargets[0] != NULL) {
+		Release_After_Batch(ChainTargets[0], NULL);
+		Release_After_Batch(ChainTargets[1], NULL);
+		ChainTargets[0] = ChainTargets[1] = NULL;
+	}
+	if (PostUsesChainTargets && ChainTargets[0] == NULL && GpuDevice != NULL && BackWidth > 0) {
+		SDL_GPUTextureCreateInfo info;
+		SDL_zero(info);
+		info.type = SDL_GPU_TEXTURETYPE_2D;
+		info.format = BACK_BUFFER_FORMAT;
+		info.usage = SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER;
+		info.width = BackWidth;
+		info.height = BackHeight;
+		info.layer_count_or_depth = 1;
+		info.num_levels = 1;
+		info.sample_count = SDL_GPU_SAMPLECOUNT_1;
+		ChainTargets[0] = SDL_CreateGPUTexture(GpuDevice, &info);
+		ChainTargets[1] = SDL_CreateGPUTexture(GpuDevice, &info);
+		if (ChainTargets[0] == NULL || ChainTargets[1] == NULL) {
+			fprintf(stderr, "post: the chain targets would not be made (%s); the chain passes stay off\n",
+				SDL_GetError());
+			if (ChainTargets[0] != NULL) Release_After_Batch(ChainTargets[0], NULL);
+			if (ChainTargets[1] != NULL) Release_After_Batch(ChainTargets[1], NULL);
+			ChainTargets[0] = ChainTargets[1] = NULL;
+			PostUsesChainTargets = false;
+			// Without the targets the passes cannot route: mask them out and
+			// plan again.  The composite, when there is one, runs alone.
+			// AO's bit goes with them: its finish step routes the same way,
+			// and the mid-scene pass shares the bit, so losing the targets
+			// costs both until the next configure.
+			PostEffectArmedMask &= ~(
+				SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_COPY)
+				| SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_FXAA)
+				| SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_SHARPEN)
+				| SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_AO));
+			plan = SdlPostPlan::Make_Plan(PostChainEffects, PostChainLength,
+				PostCompositeStep, PostEffectArmedMask, false);
+			if (PostArmed && plan.Count == 0) {
+				PostArmed = false;
+				PostCompositeStep = false;
+			}
+		}
+	}
+	PostChainPassesArmed = plan.Count > (PostCompositeStep ? 1u : 0u);
+	// The haze (v1.30 step 4): not a chain effect -- the MapLight option's,
+	// pushed as values, not as a chain entry -- so it arms on the tier alone:
+	// the full tier keeps it, the reduced tier subtracts it (committee Q4).
+	// Its program builds here, per-effect isolated like the chain's.
+	PostHazeArmed = PostArmed && PostTierState == SdlPostTier::TIER_FULL
+		&& Create_Haze_Pipelines();
+	// The mid-scene path (v1.30 step 4): armed when AO or the haze can run,
+	// on the full tier, over sampled depth.  Its targets -- the scene's copy
+	// and the occlude moment's depth -- follow the scene target's rule: made
+	// while armed, let go through the batch when not, the copy remade when
+	// the scene's format changed.  A resize remakes them with the targets.
+	PostOccludeArmed = PostArmed && PostTierState == SdlPostTier::TIER_FULL
+		&& Supports_Scene_Depth()
+		&& ((PostEffectArmedMask & SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_AO)) != 0
+			|| PostHazeArmed);
+	if (PostSceneCopy != NULL && SceneFormat != was_format) {
+		Release_After_Batch(PostSceneCopy, NULL);
+		PostSceneCopy = NULL;
+	}
+	if (!PostOccludeArmed && (PostSceneCopy != NULL || PostDepthTexture != NULL)) {
+		Release_After_Batch(PostSceneCopy, NULL);
+		Release_After_Batch(PostDepthTexture, NULL);
+		PostSceneCopy = PostDepthTexture = NULL;
+	}
+	if (PostOccludeArmed && (PostSceneCopy == NULL || PostDepthTexture == NULL)
+		&& GpuDevice != NULL && BackWidth > 0) {
+		SDL_GPUTextureCreateInfo info;
+		SDL_zero(info);
+		info.type = SDL_GPU_TEXTURETYPE_2D;
+		info.format = (SDL_GPUTextureFormat)SceneFormat;
+		info.usage = SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER;
+		info.width = BackWidth;
+		info.height = BackHeight;
+		info.layer_count_or_depth = 1;
+		info.num_levels = 1;
+		info.sample_count = SDL_GPU_SAMPLECOUNT_1;
+		if (PostSceneCopy == NULL) {
+			PostSceneCopy = SDL_CreateGPUTexture(GpuDevice, &info);
+		}
+		info.format = SDL_GPU_TEXTUREFORMAT_R32_FLOAT;
+		if (PostDepthTexture == NULL) {
+			PostDepthTexture = SDL_CreateGPUTexture(GpuDevice, &info);
+		}
+		if (PostSceneCopy == NULL || PostDepthTexture == NULL) {
+			fprintf(stderr, "post: the occlude targets would not be made (%s); the occlusion and the haze stay off\n",
+				SDL_GetError());
+			if (PostSceneCopy != NULL) Release_After_Batch(PostSceneCopy, NULL);
+			if (PostDepthTexture != NULL) Release_After_Batch(PostDepthTexture, NULL);
+			PostSceneCopy = PostDepthTexture = NULL;
+			PostOccludeArmed = false;
+		}
+	}
+	// The scene target follows the decision: made when armed, let go when not, remade
+	// when its format changed.  A batch may still name the old one, so it retires
+	// through Release_After_Batch, never straight into SDL_ReleaseGPUTexture.
+	if (SceneBuffer != NULL && (!PostArmed || SceneFormat != was_format)) {
+		Release_After_Batch(SceneBuffer, NULL);
+		SceneBuffer = NULL;
+	}
+	if (PostArmed && SceneBuffer == NULL && GpuDevice != NULL && BackWidth > 0) {
+		SDL_GPUTextureCreateInfo info;
+		SDL_zero(info);
+		info.type = SDL_GPU_TEXTURETYPE_2D;
+		info.format = (SDL_GPUTextureFormat)SceneFormat;
+		info.usage = SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER;
+		info.width = BackWidth;
+		info.height = BackHeight;
+		info.layer_count_or_depth = 1;
+		info.num_levels = 1;
+		info.sample_count = SDL_GPU_SAMPLECOUNT_1;
+		SceneBuffer = SDL_CreateGPUTexture(GpuDevice, &info);
+		if (SceneBuffer == NULL) {
+			fprintf(stderr, "post: the scene target would not be made (%s); the chain stays off\n",
+				SDL_GetError());
+			PostArmed = false;
+		}
+	}
+	PostResolved = false;
+	PostSceneUsed = false;
+	PostOccluded = false;
+	PostHazed = false;
+	// The plan's step names, for the one [post] line: what will actually run,
+	// after every subtraction above, in the order it will run.
+	{
+		std::string text;
+		for (unsigned index = 0; index < plan.Count; ++index) {
+			if (index > 0) {
+				text += ",";
+			}
+			text += plan.Steps[index].Composite ? "composite"
+				: SdlPostPlan::Effect_Name(plan.Steps[index].Effect);
+		}
+		PostPlanText = text.empty() ? "-" : text;
+	}
+	const bool ao_runs = PostOccludeArmed
+		&& (PostEffectArmedMask & SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_AO)) != 0;
+	if (!PostLogDone) {
+		PostLogDone = true;
+		fprintf(stderr, "[post] gpu '%s' tier=%s format=%s chain=\"%s\" bloom=%s plan=\"%s\" ao=%s haze=%s — %s\n",
+			identity ? identity : "?", SdlPostTier::Tier_Name(PostTierState),
+			PostFloatScene ? "R16G16B16A16_FLOAT" : "B8G8R8A8_UNORM",
+			chain_text ? chain_text : "", PostBloomArmed ? "on" : "off",
+			PostPlanText.c_str(), ao_runs ? "on" : "off",
+			PostHazeArmed ? "on" : "off", decision.Reason);
+	}
+	else if (was_armed != PostArmed || was_format != SceneFormat || was_bloom != PostBloomArmed
+		|| was_plan != PostPlanText || was_ao != ao_runs || was_haze != PostHazeArmed) {
+		fprintf(stderr, "post: reconfigured for chain \"%s\": tier=%s format=%s bloom=%s plan=\"%s\" ao=%s haze=%s — %s\n",
+			chain_text ? chain_text : "", SdlPostTier::Tier_Name(PostTierState),
+			PostFloatScene ? "R16G16B16A16_FLOAT" : "B8G8R8A8_UNORM",
+			PostBloomArmed ? "on" : "off", PostPlanText.c_str(),
+			ao_runs ? "on" : "off", PostHazeArmed ? "on" : "off", decision.Reason);
