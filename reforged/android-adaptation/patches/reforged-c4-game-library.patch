 static inline Bool isBadHeaderPointer(const void *p)
 {
+#if defined(__ANDROID__)
+	// Android's heap allocator hands out tagged pointers (a tag byte in bits
+	// 63..56; 0xb4 in the wild).  Judge the pointer with the tag stripped, or
+	// every live header on Android reads as corrupt and the guards below fire
+	// on sound blocks from the first free on.
+	p = (const void *)((uintptr_t)p & (uintptr_t)0x0000FFFFFFFFFFFF);
+#endif
 	return ((uintptr_t)p & (~(uintptr_t)0 << 48 | (MEM_BOUND_ALIGNMENT-1))) != 0;
 }
 
