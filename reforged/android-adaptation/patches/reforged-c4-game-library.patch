+			{ 4, { 13, 21, 21, 13 }, { 17, 17, 25, 25 } },
+			{ 4, { 26, 34, 34, 26 }, { 17, 17, 25, 25 } },
+			{ 4, { 39, 47, 47, 39 }, { 17, 17, 25, 25 } },
+			{ 4, { 13, 21, 21, 13 }, { 31, 31, 39, 39 } },
