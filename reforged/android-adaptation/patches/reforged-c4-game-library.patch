+/*
+** SdlTouch.h -- Reforged Android C5 touch graft entry points.
+**
+** The native touch layer (ported from the MYSOREZ/GeneralsX Android port)
+** lives in SdlTouch.cpp. The SDL event pump routes every SDL_EVENT_FINGER_*
+** event to SdlTouch_handleEvent instead of the mouse path, and calls
+** SdlTouch_applyPendingCameraMotion once per frame after the event drain.
+*/
+
+#pragma once
+
+struct SDL_Window;
+union SDL_Event;
+
+void SdlTouch_handleEvent(SDL_Window *window, const SDL_Event &event);
+void SdlTouch_applyPendingCameraMotion();
diff --git a/GeneralsMD/Code/GameEngineDevice/Include/SdlDevice/GameClient/TouchInput.h b/GeneralsMD/Code/GameEngineDevice/Include/SdlDevice/GameClient/TouchInput.h
new file mode 100644
index 00000000..6fed18fd
--- /dev/null
+++ b/GeneralsMD/Code/GameEngineDevice/Include/SdlDevice/GameClient/TouchInput.h
@@ -0,0 +1,147 @@
+/*
+**	Command & Conquer Generals Zero Hour(tm)
+**	Copyright 2025 Electronic Arts Inc.
+**
+**	This program is free software: you can redistribute it and/or modify
+**	it under the terms of the GNU General Public License as published by
+**	the Free Software Foundation, either version 3 of the License, or
+**	(at your option) any later version.
