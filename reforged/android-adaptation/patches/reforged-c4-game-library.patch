+**
+** Targets are named by selector: 0 is the scene, 1 and 2 are the frame's bloom
+** targets.  Bloom unarmed, or an intensity of zero, plans no passes and no glow:
+** the composite then runs as step 1's plain tone pass, which is dx11post's own
+** answer to an intensity of zero (its graded tone branch) and the reduced tier's
+** standing behaviour.
+*/
+
+#pragma once
+
+#ifndef SDLPOSTBLOOMPLAN_H
+#define SDLPOSTBLOOMPLAN_H
+
+namespace SdlPostBloom
+{
+	// dx11post's BLOOM_BLUR_PASS_LIMIT: the stored count is clamped there too.
+	const unsigned BLUR_PASS_LIMIT = 4;
+
+	struct Pass
+	{
+		bool Extract;				///< the bright pass over the scene; a blur otherwise
+		unsigned Source;			///< selector: 0 the scene, 1/2 the bloom targets
+		unsigned Destination;		///< selector: 1/2, a bloom target
+		float BlurX, BlurY;			///< the blur step for this pass, in source texels
+	};
+
+	struct Plan
+	{
+		Pass Passes[1 + 2 * BLUR_PASS_LIMIT];
+		unsigned Count;				///< the passes to record before the composite
+		bool Glow;					///< the composite adds the glow
+		unsigned GlowSource;		///< selector: the bloom target the composite reads
+	};
+
+	inline Plan Make_Plan(bool bloom_armed, float intensity, unsigned blur_passes,
+		unsigned bloom_width, unsigned bloom_height)
+	{
+		Plan plan;
+		plan.Count = 0;
+		plan.Glow = false;
+		plan.GlowSource = 1;
+		if (!bloom_armed || intensity <= 0.0f || bloom_width == 0 || bloom_height == 0) {
+			return plan;
+		}
+		if (blur_passes < 1) {
+			blur_passes = 1;
+		}
+		if (blur_passes > BLUR_PASS_LIMIT) {
+			blur_passes = BLUR_PASS_LIMIT;
+		}
+		const float texel_x = 1.0f / (float)bloom_width;
+		const float texel_y = 1.0f / (float)bloom_height;
+		// The bright pass: the full-size scene into the first bloom target
+		// (dx11post's Run_Bloom, its first Draw_Pass).
+		Pass & extract = plan.Passes[plan.Count++];
+		extract.Extract = true;
+		extract.Source = 0;
+		extract.Destination = 1;
+		extract.BlurX = 0.0f;
+		extract.BlurY = 0.0f;
+		// The blur pairs: each half-pass writes the other target and steps a
+		// texel wider than the pair before (Run_Bloom's spread), so the widths
+		// add up in squares.  The source flips after every half-pass, as
+		// Run_Bloom's does, and the composite reads the last one written.
+		unsigned source = 0;
+		for (unsigned pair = 0; pair < blur_passes; ++pair) {
+			const float spread = (float)(pair + 1);
+			for (unsigned axis = 0; axis < 2; ++axis) {
+				Pass & pass = plan.Passes[plan.Count++];
+				pass.Extract = false;
+				pass.Source = 1 + source;
+				pass.Destination = 1 + (1 - source);
+				pass.BlurX = (axis == 0) ? texel_x * spread : 0.0f;
+				pass.BlurY = (axis == 0) ? 0.0f : texel_y * spread;
+				source = 1 - source;
+			}
+		}
+		plan.Glow = true;
+		plan.GlowSource = 1 + source;
+		return plan;
+	}
+}
+
+#endif // SDLPOSTBLOOMPLAN_H
diff --git a/GeneralsMD/Code/GameEngineDevice/Source/PosixDevice/Render/SdlPostChain.cpp b/GeneralsMD/Code/GameEngineDevice/Source/PosixDevice/Render/SdlPostChain.cpp
new file mode 100644
index 00000000..1a3d0db7
--- /dev/null
+++ b/GeneralsMD/Code/GameEngineDevice/Source/PosixDevice/Render/SdlPostChain.cpp
@@ -0,0 +1,208 @@
+/*
+**	Copyright 2026 İlyas Akın
+**	Additional terms under GNU GPL section 7 apply: see LICENSE.md.
+**
+**	This program is free software: you can redistribute it and/or modify
+**	it under the terms of the GNU General Public License as published by
+**	the Free Software Foundation, either version 3 of the License, or
+**	(at your option) any later version.
+**
+**	This program is distributed in the hope that it will be useful,
+**	but WITHOUT ANY WARRANTY; without even the implied warranty of
+**	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+**	GNU General Public License for more details.
+**
+**	You should have received a copy of the GNU General Public License
+**	along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+// SdlPostChain.h has the design.  Step 0 (2026-11-20) was the registration and the
+// call arriving; Step 1 (2026-11-20) configures the frame for the chain at attach
+// time -- the chain was pushed before the device existed, so what it asks for is
+// already the runtime's -- and runs the one composite at the finish moment, from
+// the snapshot's values, translated into the frame's own parameter struct.
+// Step 4 (2026-11-20) registers the mid-scene occlude beside the finish, and
+// translates the snapshot's haze values with it.
+
+#include "SdlPostChain.h"
+
+#include "SdlGpuFrame.h"
+#include "SdlPostChainPlan.h"
+#include "dx11post.h"
+#include "dx11runtime.h"
+
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+// The plan header's effect values are dx11post's, so the stored chain crosses
+// between the runtime and the frame without translation (v1.30 step 3).
+static_assert(SdlPostPlan::EFFECT_COPY == (int)DX11_POST_COPY, "the chain plan's copy is dx11post's");
+static_assert(SdlPostPlan::EFFECT_FXAA == (int)DX11_POST_FXAA, "the chain plan's fxaa is dx11post's");
+static_assert(SdlPostPlan::EFFECT_SHARPEN == (int)DX11_POST_SHARPEN, "the chain plan's sharpen is dx11post's");
+static_assert(SdlPostPlan::EFFECT_AO == (int)DX11_POST_AO, "the chain plan's ao is dx11post's");
+static_assert(SdlPostPlan::EFFECT_BLOOM == (int)DX11_POST_BLOOM, "the chain plan's bloom is dx11post's");
+static_assert(SdlPostPlan::CHAIN_LIMIT == DX11_POST_CHAIN_LIMIT, "the chain plan's limit is dx11post's");
+
+namespace
+{
+	SdlGpuFrame * AttachedFrame = NULL;
+	unsigned long long FinishCallCount = 0;
+
+	// The chain the attached frame was last configured for.  Through step 2
+	// two of its facts were compared (was anything requested, does it start
+	// with bloom), which a change from "fxaa" to "sharpen" slipped past;
+	// step 3 compares the chain itself, and a change in it reconfigures the
+	// frame once.  The per-frame values flow through Finish_Scene regardless.
+	bool Configured = false;
+	bool ConfiguredChainSet = false;
+	unsigned ConfiguredLength = 0;
+	int ConfiguredEffects[4] = { 0, 0, 0, 0 };	///< SdlPostPlan::CHAIN_LIMIT of them
+
+	bool Same_Chain(const DX11PostParameters & parameters)
+	{
+		if (parameters.ChainSet != ConfiguredChainSet
+			|| parameters.ChainLength != ConfiguredLength) {
+			return false;
+		}
+		for (unsigned index = 0; index < parameters.ChainLength; ++index) {
+			if ((int)parameters.Chain[index] != ConfiguredEffects[index]) {
+				return false;
+			}
+		}
+		return true;
+	}
+
+	// The runtime's armed question (v1.30 step 2), answered from the attached
+	// frame at the moment it is asked: arming follows reconfiguration and
+	// resize, so nothing on either side caches it.
+	bool chain_armed()
+	{
+		return AttachedFrame != NULL && AttachedFrame->Post_Armed();
+	}
+
+	// The runtime's bloom-armed question (v1.30 step 2b), answered from the
+	// attached frame at the moment it is asked, like the armed answer above:
+	// the frame's bloom arming follows its tier decision and pipeline build.
+	bool bloom_armed()
+	{
+		return AttachedFrame != NULL && AttachedFrame->Post_Bloom_Armed();
+	}
+
+	void configure(SdlGpuFrame * frame, const DX11PostParameters & parameters)
+	{
+		char text[128];
+		size_t used = 0;
+		text[0] = '\0';
+		for (unsigned index = 0; index < parameters.ChainLength; ++index) {
+			const char * name = DX11Post_Effect_Name(parameters.Chain[index]);
+			const size_t length = strlen(name) + (index > 0 ? 1 : 0);
+			if (used + length < sizeof(text)) {
+				if (index > 0) {
+					text[used++] = ',';
+				}
+				memcpy(text + used, name, strlen(name) + 1);
+				used += strlen(name);
+			}
+		}
+		int effects[4] = { 0, 0, 0, 0 };
+		for (unsigned index = 0; index < parameters.ChainLength && index < 4; ++index) {
+			effects[index] = (int)parameters.Chain[index];
+		}
+		frame->Configure_Post(effects, parameters.ChainLength, text);
+		Configured = true;
+		ConfiguredChainSet = parameters.ChainSet;
+		ConfiguredLength = parameters.ChainLength;
+		for (unsigned index = 0; index < 4; ++index) {
+			ConfiguredEffects[index] = effects[index];
+		}
+	}
+}
+
+namespace SdlPostChain
+{
+	void Attach(SdlGpuFrame * frame)
+	{
+		AttachedFrame = frame;
+		Direct3D11_Register_Post_Finish(&Finish_Scene);
+		Direct3D11_Register_Post_Armed(&chain_armed);
+		Direct3D11_Register_Post_Bloom_Armed(&bloom_armed);
+		Direct3D11_Register_Post_Occlude(&Occlude_Scene);
+		DX11PostParameters parameters;
+		Direct3D11_Post_Snapshot(parameters);
+		configure(frame, parameters);
+	}
+
+	void Detach(SdlGpuFrame * frame)
+	{
+		if (AttachedFrame == frame) {
+			AttachedFrame = NULL;
+			Configured = false;
+			Direct3D11_Register_Post_Finish(NULL);
+			Direct3D11_Register_Post_Armed(NULL);
+			Direct3D11_Register_Post_Bloom_Armed(NULL);
+			Direct3D11_Register_Post_Occlude(NULL);
+		}
+	}
+
+	void Finish_Scene(const DX11PostParameters & parameters)
+	{
+		++FinishCallCount;
+		if (AttachedFrame == NULL) {
+			return;
+		}
+		if (!Configured || !Same_Chain(parameters)) {
+			configure(AttachedFrame, parameters);
+		}
+		// The values arrive -- the bloom tuning, the grade, the InternalHdr choice
+		// -- and the frame runs its passes from them.  Step 2 reads the bloom
+		// tuning in full: the composite adds the glow the extract and blur pairs
+		// made, at the stored intensity.  The haze, atmosphere and warps in the
+		// snapshot are Step 4's and the present gate's, and are not read here.
+		SdlGpuFrame::SdlPostParameters post;
+		post.BloomThreshold = parameters.BloomThreshold;
+		post.BloomIntensity = parameters.BloomIntensity;
+		post.BloomAdditiveGain = parameters.BloomAdditiveGain;
+		post.BloomBlurPasses = parameters.BloomBlurPasses;
+		post.GradeAmount = parameters.GradeAmount;
+		post.InternalHdr = parameters.InternalHdr;
+		AttachedFrame->Run_Post_Chain(post);
+	}
+
+	void Occlude_Scene(const DX11PostParameters & parameters,
+		const float world_from_clip[16], bool has_world)
+	{
+		if (AttachedFrame == NULL) {
+			return;
+		}
+		// The mid-scene values: the haze the MapLight and Weather options
+		// computed this frame, and the shroud texture the runtime borrowed
+		// for this frame -- still the terrain's Direct3D 9 texture here; the
+		// frame translates it through the device's mirror when it records,
+		// as a draw does.  The chain is not reconfigured here: the finish
+		// moment owns that, and the chain cannot change mid-frame.
+		SdlGpuFrame::SdlPostParameters post;
+		memset(&post, 0, sizeof(post));
+		post.BloomThreshold = parameters.BloomThreshold;
+		post.BloomIntensity = parameters.BloomIntensity;
+		post.BloomAdditiveGain = parameters.BloomAdditiveGain;
+		post.BloomBlurPasses = parameters.BloomBlurPasses;
+		post.GradeAmount = parameters.GradeAmount;
+		post.InternalHdr = parameters.InternalHdr;
+		memcpy(post.HazeColour, parameters.HazeColour, sizeof(post.HazeColour));
+		post.HazeTop = parameters.HazeTop;
+		post.HazeThickness = parameters.HazeThickness;
+		post.HazeStrength = parameters.HazeStrength;
+		post.HazeReach = parameters.HazeReach;
+		post.HazeWater = parameters.HazeWater;
+		memcpy(post.HazeSun, parameters.HazeSun, sizeof(post.HazeSun));
+		post.HazeShroud = parameters.HazeShroudView;
+		memcpy(post.HazeShroudRect, parameters.HazeShroudRect, sizeof(post.HazeShroudRect));
+		AttachedFrame->Run_Post_Occlude(post, world_from_clip, has_world);
+	}
+
+	unsigned long long Finish_Calls()
+	{
+		return FinishCallCount;
+	}
+}
