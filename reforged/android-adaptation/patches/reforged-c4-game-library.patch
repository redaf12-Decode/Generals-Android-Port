+/*
+** The post chain's tier decision (v1.30 step 1, 2026-11-20; committee Q4), as a pure
+** function of plain facts so the whole table can be checked host-side: the device
+** supplies the capability answer, the identity parse, the stored chain and the
+** environment overrides, and this says what runs.
+**
+** Two axes, both required for the float scene: the device must be able to render
+** and sample R16G16B16A16_FLOAT, and the GPU must not be a known-weak part
+** (SdlGpuIdentity).  FULL (the default, failing open) runs the float scene when the
+** chain starts with bloom -- the fork's own rule (dx11post.cpp: the float scene
+** exists only for bloom; nothing above 1.0 can be generated without it) -- and the
+** tone/grade composite brings it down.  REDUCED (known-weak parts only) keeps an
+** 8-bit scene and subtracts bloom and ao from the effective chain; the tone/grade
+** composite still runs, because it is the tier's kept parity win.  A FULL device
+** without float capability lands on the same 8-bit composite (the committee's
+** NOFLOAT behaviour).  Composition is subtraction-only over the game's chain: this
+** never adds an effect the game did not ask for, and a chain that was not
+** requested, was refused, or is "off" runs nothing at all.
+**
+** Overrides mirror the shadow gates' (ZH_SHADOW_COARSE / ZH_SHADOW_TEXELS):
+** ZH_POST_FLOAT=0 forbids the float scene, =1 lifts the weak axis (capability and
+** the bloom-first rule still bind -- no override can conjure hardware, and float
+** without bloom buys nothing); ZH_POST_TIER=full|reduced|off replaces the tier.
+**
+** Step 3 (2026-11-20): the decision also says whether the post path arms at
+** all (Arm).  Through step 2 arming was the composite's, so a chain of passes
+** only -- "fxaa" on a strong phone -- armed nothing and its passes had nowhere
+** to run.  Now the frame arms whenever the composite runs or the chain holds
+** an effect that runs as a pass (anything but AO, which is step 4's); the
+** composite stays what it was, the bring-down step of a bloom-first chain on
+** the full tier and the reduced tier's kept win.
+**
+** Step 4 (2026-11-20): AO arms the path too, on the full tier.  AO runs
+** mid-scene (dx11post's Occlude_Scene), not at the finish, but it needs the
+** scene target to exist like every other part of the chain; a chain of AO
+** alone on the full tier therefore arms, where step 3 armed nothing.  The
+** reduced tier is untouched: its composite already arms it, and AO stays
+** subtracted there (the frame never builds AO's programs off the full tier).
+*/
+
+#pragma once
+
+#ifndef SDLPOSTTIER_H
+#define SDLPOSTTIER_H
+
+namespace SdlPostTier
+{
+	enum Tier
+	{
+		TIER_OFF = 0,
+		TIER_REDUCED = 1,
+		TIER_FULL = 2
+	};
+
+	struct Decision
+	{
+		int Tier;			///< a Tier value
+		bool FloatScene;	///< the scene target is R16G16B16A16_FLOAT
+		bool Composite;		///< the tone/grade composite runs at Finish_Scene
+		bool Arm;			///< the post path arms: a scene target, and passes at Finish_Scene (step 3)
+		const char * Reason;
+	};
+
+	// env_float: -1 auto, 0 force off, 1 force on.  env_tier: -1 auto, else a Tier.
+	// chain_has_non_ao_effect: the chain holds an effect that runs as a pass
+	// (step 3).  chain_has_ao: the chain holds AO -- mid-scene, not a finish
+	// pass, but on the full tier it arms the path for its scene target (step 4).
+	inline Decision Decide(bool chain_requested, bool chain_starts_bloom, bool chain_has_non_ao_effect,
+		bool chain_has_ao, bool float_capable, bool known_weak, int env_float, int env_tier)
+	{
+		Decision decision;
+		decision.Tier = (env_tier >= 0) ? env_tier
+			: (known_weak ? (int)TIER_REDUCED : (int)TIER_FULL);
+		decision.FloatScene = false;
+		decision.Composite = false;
+		decision.Arm = false;
+		decision.Reason = "";
+
+		if (decision.Tier == TIER_OFF) {
+			decision.Reason = "ZH_POST_TIER=off: the chain does not run";
+			return decision;
+		}
+		if (!chain_requested) {
+			// Off, whatever the environment asks: there is no chain to run a tier of.
+			decision.Tier = TIER_OFF;
+			decision.Reason = "no chain requested";
+			return decision;
+		}
+		decision.Arm = true;	// a requested chain on a live tier; narrowed below
+
+		bool float_wanted = chain_starts_bloom && (decision.Tier == TIER_FULL || env_float == 1);
+		if (env_float == 0) {
+			float_wanted = false;
+		}
+		decision.FloatScene = float_wanted && float_capable;
+
+		if (decision.Tier == TIER_REDUCED) {
+			// The tier's kept win runs on either scene: with the float scene the
+			// composite is its bring-down, without it the tone/grade pass itself.
+			decision.Composite = true;
+			decision.Reason = decision.FloatScene
+				? "ZH_POST_FLOAT=1 lifts the weak axis: float scene, tone/grade bring-down"
+				: (known_weak && env_tier < 0)
+					? "known-weak gpu: 8-bit scene, bloom/ao subtracted, tone/grade kept"
+					: "reduced tier: 8-bit scene, bloom/ao subtracted, tone/grade kept";
+			return decision;
+		}
+
+		// FULL from here.
+		if (!chain_starts_bloom) {
+			// No float (nothing above 1.0 to keep) and no tone/grade either: on
+			// Windows such a chain is its own passes (fxaa/sharpen/copy) and
+			// nothing else touches the picture.  The passes still need the
+			// scene target and the finish moment, so the path arms for them
+			// (step 3); AO needs the scene target the same way for its
+			// mid-scene pass, so it arms the path too (step 4).
+			decision.Arm = chain_has_non_ao_effect || chain_has_ao;
+			decision.Reason = chain_has_non_ao_effect
+				? "the chain does not start with bloom: no float scene, no tone/grade; its passes run over an eight-bit scene"
+				: chain_has_ao
+					? "the chain does not start with bloom: no float scene, no tone/grade; its ao runs mid-scene over an eight-bit scene"
+					: "the chain does not start with bloom: no float scene, no tone/grade, and nothing else of it runs";
+			return decision;
+		}
+		decision.Composite = true;
+		if (decision.FloatScene) {
+			decision.Reason = "bloom-first chain, float-capable gpu: float scene, tone/grade bring-down";
+		}
+		else if (!float_capable) {
+			decision.Reason = "bloom-first chain but no float colour target: tone/grade on an 8-bit scene";
+		}
+		else {
+			decision.Reason = "ZH_POST_FLOAT=0: tone/grade on an 8-bit scene";
+		}
+		return decision;
+	}
+
+	inline const char * Tier_Name(int tier)
+	{
+		switch (tier) {
+		case TIER_OFF: return "off";
+		case TIER_REDUCED: return "reduced";
+		default: return "full";
+		}
+	}
+}
+
+#endif // SDLPOSTTIER_H
