+**	GNU General Public License for more details.
+**
+**	You should have received a copy of the GNU General Public License
+**	along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+/*
+** The per-pixel dynamic lights' decisions (v1.30 step 5, 2026-11-21), as pure
+** functions of plain facts so the whole table can be checked host-side: the
+** device supplies its sun receiver state and the environment's allowance, and
+** this says whether the gate is live and how many of the frame's light slots
+** one receiver draw's constants carry.
+**
+** The gate is the Windows gate's analogue, fact for fact: there it is the
+** backend's ShadowReceiving with a shadow map held (dx11backend.h), on a run
+** whose backend is active.  Here the device is registered (the runtime's side
+** of that fact), its sun capture is ready and its receiver parameters are set
+** (the capture and the receiving), no receiver failure is latched (a failed
+** receiver program falls the whole scene back to the legacy shadows, and the
+** lights fall with it rather than lighting a picture the shadows left), and
+** the environment has not forbidden the step (ZH_LIGHTS_PIXEL=0, the off
+** switch: the gate closes, the game's vertex lights stay, and the fill below
+** never runs -- the two are the same answer read in two places, so the
+** dynamic lights are lit per pixel or per vertex, never both, never neither).
+**
+** The counts are DX11BackendClass's Upload_Pixel_Constants subtractions, plus
+** the one subtraction that is this port's own: his blast count is zero for a
+** camera-space draw (the sorted particles, whose smoke takes these lights on
+** the CPU already) and for a pass that multiplies what is under it -- and the
+** second of those has no draw to reach the fill here, because PosixDevice9's
+** Sun_Receiving already refuses the receiver programs to the additive and
+** multiplicative blends.  His headlight count is filled for every receiver
+** draw, camera space included.  Ours adds the known-weak cap (committee:
+** slot count ~8 until ZH_GPU_TIMING numbers exist): both families were
+** sorted nearest the camera first by the collectors that handed them over,
+** so the slots past the cap are the frame's farthest lights and dropping
+** them is the safe truncation.  A GPU that is not known-weak is never
+** capped -- the gate helps parts known to be weak and fails open on the
+** rest, the shadow gates' own rule.
+*/
+
+#pragma once
+
+#ifndef SDLPIXELLIGHTS_H
+#define SDLPIXELLIGHTS_H
+
+namespace SdlPixelLights
+{
+	// The slots of either family a known-weak GPU's receiver constants
+	// carry.
+	const unsigned WEAK_SLOT_CAP = 8;
+
+	// The gate's answer: the per-pixel path is the frame's dynamic light
+	// exactly when every fact holds.
+	inline bool Receiver_Active(bool env_allowed, bool has_sun, bool sun_ready,
+		bool receiving, bool receiver_failed)
+	{
+		return env_allowed && has_sun && sun_ready && receiving && !receiver_failed;
+	}
+
+	// The blast lights one receiver draw's constants carry: none for a
+	// camera-space draw, the weak cap on a known-weak GPU, else what the
+	// game handed over.
+	inline unsigned Blast_Count(unsigned handed, bool camera_space, bool weak_gpu)
+	{
+		if (camera_space) {
+			return 0;
+		}
+		return (weak_gpu && handed > WEAK_SLOT_CAP) ? WEAK_SLOT_CAP : handed;
+	}
+
+	// The headlights one receiver draw's constants carry: the weak cap is
+	// the only subtraction.
+	inline unsigned Headlight_Count(unsigned handed, bool weak_gpu)
+	{
+		return (weak_gpu && handed > WEAK_SLOT_CAP) ? WEAK_SLOT_CAP : handed;
+	}
+}
+
+#endif // SDLPIXELLIGHTS_H
