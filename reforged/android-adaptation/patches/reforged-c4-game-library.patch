diff --git a/GeneralsMD/Code/GameEngine/Include/GameClient/UserUiScale.h b/GeneralsMD/Code/GameEngine/Include/GameClient/UserUiScale.h
new file mode 100644
index 00000000..8fb6161b
--- /dev/null
+++ b/GeneralsMD/Code/GameEngine/Include/GameClient/UserUiScale.h
@@ -0,0 +1,37 @@
+#pragma once
+
+// User interface scale (v1.29, owner's order 2026-11-20): the launcher's
+// "interface size" slider saves GXUiScale (percent, 100-200) in Options.ini --
+// the contract MYSOREZ's launcher and its GXUiScale feature used. Our launcher
+// activity reads that value from our own user folder's Options.ini and passes
+// it to the engine as the GX_UI_SCALE environment variable; this factor is
+// what the engine's own scale points multiply by:
+//   - ControlBarUniformScaleFor / ControlBarHudScaleFor (the control bar, the
+//     radar, the C5 touch buttons, the science and power layouts the bar
+//     places), capped at the display's own horizontal stretch so the bar can
+//     never outgrow the screen;
+//   - the fitted (LAYOUT_FIT) dialogs and menus in parseScreenRect, clamped
+//     back onto the screen window by window, with their fonts in parseFont.
+// 100% (or unset) is exactly the shipped behaviour: every multiplication is
+// by 1. Client-side presentation only; nothing here touches game logic.
+
+#include "Lib/BaseType.h"
+
+#include <cstdlib>
+
+inline Real UserUiScaleFactor( void )
+{
+	static Real s_factor = -1.0f;
+	if( s_factor < 0.0f )
+	{
+		s_factor = 1.0f;
+		const char *env = getenv( "GX_UI_SCALE" );
+		if( env )
+		{
+			const Int percent = atoi( env );
+			if( percent > 100 && percent <= 200 )
+				s_factor = percent / 100.0f;
+		}
+	}
+	return s_factor;
+}
