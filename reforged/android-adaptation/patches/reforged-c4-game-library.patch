+bool SdlGpuFrame::Create_Post_Pipelines()
+{
+	if (PostTonePipeline != NULL && PostToneWidePipeline != NULL && PostCopyPipeline != NULL
+		&& PostSampler != NULL) {
+		return true;
+	}
+	std::string log;
+	if (PostVertex == NULL) {
+		std::vector<unsigned char> spirv;
+		if (!SDL3_Compile_HLSL_To_SPIRV(POST_VERTEX_HLSL, true, spirv, log)
+			|| (PostVertex = SDL3_Create_Shader(GpuDevice, spirv, true, log)) == NULL) {
+			fprintf(stderr, "post: the composite's vertex program: %s\n", log.c_str());
+			return false;
+		}
+	}
+	struct PostBuild { SDL_GPUShader ** Shader; SDL_GPUGraphicsPipeline ** Pipeline; const char * Source; const char * Name; };
+	const PostBuild builds[3] = {
+		{ &PostTonePixel, &PostTonePipeline, POST_TONE_HLSL, "tone" },
+		{ &PostToneWidePixel, &PostToneWidePipeline, POST_TONE_WIDE_HLSL, "tone (wide)" },
+		{ &PostCopyPixel, &PostCopyPipeline, POST_COPY_HLSL, "copy" },
+	};
+	for (int index = 0; index < 3; ++index) {
+		const PostBuild & build = builds[index];
+		if (*build.Shader == NULL) {
+			std::vector<unsigned char> spirv;
+			if (!SDL3_Compile_HLSL_To_SPIRV(build.Source, false, spirv, log)
+				|| (*build.Shader = SDL3_Create_Shader(GpuDevice, spirv, false, log)) == NULL) {
+				fprintf(stderr, "post: the composite's %s program: %s\n", build.Name, log.c_str());
+				return false;
+			}
+		}
+		if (*build.Pipeline == NULL) {
+			SDL_GPUColorTargetDescription target;
+			SDL_zero(target);
+			target.format = BACK_BUFFER_FORMAT;
+			SDL_GPUGraphicsPipelineCreateInfo info;
+			SDL_zero(info);
+			info.vertex_shader = PostVertex;
+			info.fragment_shader = *build.Shader;
+			info.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+			info.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
+			info.rasterizer_state.cull_mode = SDL_GPU_CULLMODE_NONE;
+			info.target_info.color_target_descriptions = &target;
+			info.target_info.num_color_targets = 1;
+			*build.Pipeline = SDL_CreateGPUGraphicsPipeline(GpuDevice, &info);
+			if (*build.Pipeline == NULL) {
+				fprintf(stderr, "post: the composite's %s pipeline: %s\n", build.Name, SDL_GetError());
+				return false;
+			}
+		}
+	}
+	if (PostSampler == NULL) {
+		// dx11post's pass sampler (its CreateSamplerState): linear, clamped.
+		SDL_GPUSamplerCreateInfo sampler;
+		SDL_zero(sampler);
+		sampler.min_filter = SDL_GPU_FILTER_LINEAR;
+		sampler.mag_filter = SDL_GPU_FILTER_LINEAR;
+		sampler.mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_NEAREST;
+		sampler.address_mode_u = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+		sampler.address_mode_v = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+		sampler.address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+		PostSampler = SDL_CreateGPUSampler(GpuDevice, &sampler);
+		if (PostSampler == NULL) {
+			fprintf(stderr, "post: the composite's sampler: %s\n", SDL_GetError());
+			return false;
+		}
+	}
+	return true;
+}
