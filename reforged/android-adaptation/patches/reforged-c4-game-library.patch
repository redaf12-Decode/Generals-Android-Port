+**	but WITHOUT ANY WARRANTY; without even the implied warranty of
+**	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+**	GNU General Public License for more details.
+**
+**	You should have received a copy of the GNU General Public License
+**	along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+/*
+** The SDL GPU side of the Direct3D 11 post chain (v1.30 step 0, 2026-11-20).
+**
+** dx11runtime_posix.cpp keeps the chain and every DX11Post parameter the game sets, but it
+** cannot see this device: WW3D2 has no include path here and no handle on the live
+** SdlGpuFrame.  This is the bridge between them.  When PosixDevice9 makes its frame it
+** attaches it here, which registers Finish_Scene with the runtime; the runtime calls it at
+** the moment the world is drawn and the two dimensional draws are about to go over it,
+** with a snapshot of everything the game asked for.  Detach unregisters again before the
+** frame goes away, so the runtime never calls into a dead device — it complains
+** ("post: unregistered") instead, out loud.
+**
+** Step 0 ran no passes.  Step 1 (2026-11-20): Attach also configures the frame for
+** the stored chain (SdlGpuFrame::Configure_Post -- the tier, the scene target, the one
+** [post] line), and Finish_Scene runs the frame's one composite (tone curve, wide_curve
+** under InternalHdr, and the grade) from the snapshot's values, recorded into the
+** frame's batch at this point of the frame.  Bloom's contribution is zero by
+** construction until Step 2; the rest of the chain lands in its own steps.
+**
+** Step 2 (2026-11-20): bloom proper.  On the full tier over the float scene,
+** Finish_Scene first records dx11post's bright-pass extract and widening blur
+** pairs at quarter resolution (the plan in SdlPostBloomPlan), and the composite
+** adds the glow at the stored intensity -- the wide body under InternalHdr.
+** Attach also registers the frame's armed answer (Direct3D11_Register_Post_Armed),
+** which the runtime's narrow Direct3D11_Post_Is_Active() asks; Detach clears it
+** with the finish function.
+**
+** Step 2b (2026-11-20): Attach also registers the frame's bloom-armed answer
+** (Direct3D11_Register_Post_Bloom_Armed), which the runtime's
+** Direct3D11_Post_Bloom_Is_Active() asks; Detach clears it with the others.
+**
+** Step 3 (2026-11-20): the chain's own passes run -- fxaa and sharpen in the
+** stored chain's order, over the frame's chain targets (SdlPostChainPlan's
+** routing).  The bridge hands Configure_Post the chain itself now, not two of
+** its facts, and Finish_Scene reconfigures when the chain itself changes.
+**
+** Step 4 (2026-11-20): the mid-scene moment registers too.  The runtime calls
+** Occlude_Scene -- the world drawn, the particles not yet -- with the same
+** snapshot and the world-from-clip matrix it computed from the scene view
+** the shadow pass handed over; the bridge translates the haze values and the
+** borrowed shroud texture pointer into the frame's parameter struct, and the
+** frame records the chain's AO and the MapLight haze there.
+**
+** Main thread only, as every SDL GPU call is.
+*/
+
+#pragma once
+
+#ifndef SDLPOSTCHAIN_H
+#define SDLPOSTCHAIN_H
+
+class SdlGpuFrame;
+struct DX11PostParameters;
+
+namespace SdlPostChain
+{
+	// Register the post finish for this frame with the runtime
+	// (Direct3D11_Register_Post_Finish), and configure the frame for the chain the
+	// runtime already holds.  Called by PosixDevice9::Create_Gpu_Frame as soon as
+	// the frame exists.
+	void Attach(SdlGpuFrame * frame);
+
+	// Unregister again, if this frame is the attached one.  Called by PosixDevice9 before
+	// the frame is deleted.
+	void Detach(SdlGpuFrame * frame);
+
+	// The runtime's callback: the world is drawn and the kept post values are in
+	// parameters.  Step 1 runs the frame's composite from them.
+	void Finish_Scene(const DX11PostParameters & parameters);
+
+	// The runtime's mid-scene callback (step 4): the world is drawn, the
+	// particles are not, and the kept post values are in parameters;
+	// world_from_clip takes a pixel back into the world, when the runtime
+	// could compute one (has_world).
+	void Occlude_Scene(const DX11PostParameters & parameters,
+		const float world_from_clip[16], bool has_world);
+
+	// How many times Finish_Scene has been called since this process started.
+	unsigned long long Finish_Calls();
+}
+
+#endif // SDLPOSTCHAIN_H
diff --git a/GeneralsMD/Code/GameEngineDevice/Source/PosixDevice/Render/SdlPostChainPlan.h b/GeneralsMD/Code/GameEngineDevice/Source/PosixDevice/Render/SdlPostChainPlan.h
new file mode 100644
index 00000000..1f856f87
--- /dev/null
+++ b/GeneralsMD/Code/GameEngineDevice/Source/PosixDevice/Render/SdlPostChainPlan.h
@@ -0,0 +1,192 @@
+/*
+**	Copyright 2026 İlyas Akın
+**	Additional terms under GNU GPL section 7 apply: see LICENSE.md.
+**
+**	This program is free software: you can redistribute it and/or modify
+**	it under the terms of the GNU General Public License as published by
+**	the Free Software Foundation, either version 3 of the License, or
+**	(at your option) any later version.
+**
+**	This program is distributed in the hope that it will be useful,
+**	but WITHOUT ANY WARRANTY; without even the implied warranty of
+**	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+**	GNU General Public License for more details.
+**
+**	You should have received a copy of the GNU General Public License
+**	along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+/*
+** The post chain's pass plan (v1.30 step 3, 2026-11-20).
+**
+** dx11post's Finish (dx11post.cpp), reduced to the decisions it makes about
+** order and routing, in the shape of SdlPostTier and SdlPostBloomPlan: pure and
+** device-free, so the whole table is provable off-device, and
+** SdlGpuFrame::Run_Post_Chain records exactly this, step for step.
+**
+** The first step, when the tier runs one, is the composite: the step that
+** brings the scene to eight bits (bloom's composite or the tone pass on the
+** full tier, the tone/grade composite on the reduced tier, whose stored bloom
+** is subtracted but whose grade is kept).  It writes the back buffer when it
+** is the only step -- dx11post's "alone" -- and the first chain target
+** otherwise, and the passes after it read what it wrote.  The passes are the
+** stored chain's remaining effects in the chain's own order, each reading the
+** previous step's target and writing the other chain target, the last one
+** writing the back buffer, so an odd or an even count both end on the screen.
+**
+** Two subtractions are already the caller's, not this plan's: the tier's
+** (SdlPostTier) and the per-effect one -- an effect whose program would not
+** build is dropped by the armed mask (per-effect isolation, committee Q1),
+** which is dx11post's Run_Chain shape (it too runs a filtered copy of the
+** stored chain).  The multisampled substitutions of Run_Chain never fire
+** here: the scene is one sample by construction (MSAA stays a stub in 1.30),
+** so FXAA is never stripped and sharpen never takes its multisampled body.
+**
+** Step 4 (2026-11-20): AO takes its place in the plan.  Its home is mid-scene
+** (dx11post's Occlude_Scene, before the particles), and Run_Chain strips it
+** from the finish chain whenever the scene already took its occlusion this
+** frame -- Make_Plan's ao_occluded input is that strip.  When the occlusion
+** did not run (the mid-scene moment found the draws away from the scene
+** target, dx11post's own refusal), the AO step stays in the plan and runs
+** here at the finish, over the finished scene, exactly as dx11post's Finish
+** runs it then.  The tier subtraction needs no test in this header: the
+** frame builds AO's programs only on the full tier, so off it the armed mask
+** never carries AO's bit and the mask subtraction above removes the step.
+*/
+
+#pragma once
+
+#ifndef SDLPOSTCHAINPLAN_H
+#define SDLPOSTCHAINPLAN_H
+
+namespace SdlPostPlan
+{
+	// The stored chain's effects, as plain ints mirroring WW3D2's DX11PostEffect
+	// (dx11post.h) one for one -- SdlPostChain, which sees both, asserts the
+	// match.  Plain ints keep this header free of the device and of WW3D2.
+	const int EFFECT_COPY = 0;
+	const int EFFECT_FXAA = 1;
+	const int EFFECT_SHARPEN = 2;
+	const int EFFECT_AO = 3;
+	const int EFFECT_BLOOM = 4;
+
+	// Room for every effect at once (DX11_POST_CHAIN_LIMIT).
+	const unsigned CHAIN_LIMIT = 4;
+
+	// The bit for an effect in an armed mask.
+	inline unsigned Effect_Bit(int effect)
+	{
+		return 1u << (unsigned)effect;
+	}
+
+	// Texture selectors a step reads or writes: the scene, the two chain
+	// targets, and the back buffer (a destination only).
+	const unsigned TARGET_SCENE = 0;
+	const unsigned TARGET_CHAIN_0 = 1;
+	const unsigned TARGET_CHAIN_1 = 2;
+	const unsigned TARGET_BACK_BUFFER = 3;
+
+	struct Step
+	{
+		bool Composite;			///< the bring-down step; an effect pass otherwise
+		int Effect;				///< the pass's effect; meaningless for the composite
+		unsigned Source;		///< a TARGET_ selector
+		unsigned Destination;	///< a TARGET_ selector
+	};
+
+	struct Plan
+	{
+		Step Steps[1 + CHAIN_LIMIT];
+		unsigned Count;				///< the steps to record at Finish_Scene
+		bool UsesChainTargets;		///< any step writes a chain target
+	};
+
+	// composite_step: the tier's decision to run the bring-down step (on the
+	// full tier it stands in for a bloom first in the chain; on the reduced
+	// tier it runs ahead of the kept passes).  effect_mask: the effects whose
+	// programs built, by Effect_Bit.  ao_occluded: the scene already took its
+	// occlusion mid-scene this frame, so AO is stripped from the finish plan
+	// (dx11post's Run_Chain does exactly this); Configure_Post passes false,
+	// Run_Post_Chain the frame's own answer.
+	inline Plan Make_Plan(const int * chain, unsigned chain_length, bool composite_step,
+		unsigned effect_mask, bool ao_occluded)
+	{
+		Plan plan;
+		plan.Count = 0;
+		plan.UsesChainTargets = false;
+		if (chain == 0) {
+			chain_length = 0;
+		}
+		if (chain_length > CHAIN_LIMIT) {
+			chain_length = CHAIN_LIMIT;
+		}
+
+		// The passes, in the chain's order: the first slot is skipped when it
+		// names bloom (the composite step stands in for it on the full tier,
+		// and the reduced tier subtracted it), AO is stripped when the scene
+		// took its occlusion mid-scene, and an effect outside the armed mask
+		// does not run.
+		int passes[CHAIN_LIMIT];
+		unsigned pass_count = 0;
+		const unsigned begin = (chain_length > 0 && chain[0] == EFFECT_BLOOM) ? 1 : 0;
+		for (unsigned index = begin; index < chain_length; ++index) {
+			const int effect = chain[index];
+			if (effect == EFFECT_AO && ao_occluded) {
+				continue;
+			}
+			if ((effect_mask & Effect_Bit(effect)) == 0) {
+				continue;
+			}
+			passes[pass_count++] = effect;
+		}
+
+		const unsigned total = (composite_step ? 1 : 0) + pass_count;
+		if (total == 0) {
+			return plan;
+		}
+
+		unsigned source = TARGET_SCENE;
+		if (composite_step) {
+			Step & step = plan.Steps[plan.Count++];
+			step.Composite = true;
+			step.Effect = -1;
+			step.Source = TARGET_SCENE;
+			step.Destination = (total == 1) ? TARGET_BACK_BUFFER : TARGET_CHAIN_0;
+			if (step.Destination != TARGET_BACK_BUFFER) {
+				plan.UsesChainTargets = true;
+			}
+			source = TARGET_CHAIN_0;
+		}
+		unsigned next_write = composite_step ? 1 : 0;
+		for (unsigned index = 0; index < pass_count; ++index) {
+			const bool last = (index + 1 == pass_count);
+			Step & step = plan.Steps[plan.Count++];
+			step.Composite = false;
+			step.Effect = passes[index];
+			step.Source = source;
+			step.Destination = last ? TARGET_BACK_BUFFER
+				: (next_write == 0 ? TARGET_CHAIN_0 : TARGET_CHAIN_1);
+			if (step.Destination != TARGET_BACK_BUFFER) {
+				plan.UsesChainTargets = true;
+			}
+			source = step.Destination;
+			next_write = 1 - next_write;
+		}
+		return plan;
+	}
+
+	// The name an effect goes by in the [post] line, mirroring
+	// DX11Post_Effect_Name.
+	inline const char * Effect_Name(int effect)
+	{
+		switch (effect) {
+		case EFFECT_FXAA: return "fxaa";
+		case EFFECT_SHARPEN: return "sharpen";
+		case EFFECT_AO: return "ao";
+		case EFFECT_BLOOM: return "bloom";
+		default: return "copy";
+		}
+	}
+}
+
+#endif // SDLPOSTCHAINPLAN_H
