+// What was actually asked for, in place of the old unconditional "post-process off".
+const char * Direct3D11_Post_Diagnostic()
+{
+	static char diagnostic[192];
+	if (!PostChainSet) {
+		return "post-process: no chain requested";
+	}
+	if (!PostChainUnderstood) {
+		snprintf(diagnostic, sizeof(diagnostic), "post-process: chain \"%s\" refused", PostChainText.c_str());
+		return diagnostic;
+	}
+	if (PostChainLength == 0) {
+		return "post-process: chain requested off";
+	}
+	std::string names;
+	for (unsigned index = 0; index < PostChainLength; ++index) {
+		if (index > 0) {
+			names += ",";
+		}
+		names += DX11Post_Effect_Name(PostChain[index]);
+	}
