+
+bool SdlGpuFrame::Create_Bloom_Pipelines()
+{
+	if (PostBloomExtractPipeline != NULL && PostBloomBlurPipeline != NULL
+		&& PostBloomCompositePipeline != NULL && PostBloomCompositeWidePipeline != NULL) {
+		return true;
+	}
+	if (PostVertex == NULL) {
+		// The composite's build makes the shared vertex program first; bloom is
+		// only ever asked for after it (Configure_Post's order).
+		return false;
+	}
+	struct BloomBuild { SDL_GPUShader ** Shader; SDL_GPUGraphicsPipeline ** Pipeline; const char * Source; const char * Name; unsigned int Format; };
+	const BloomBuild builds[4] = {
+		{ &PostBloomExtractPixel, &PostBloomExtractPipeline, POST_BLOOM_EXTRACT_HLSL, "bloom extract",
+			(unsigned int)SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT },
+		{ &PostBloomBlurPixel, &PostBloomBlurPipeline, POST_BLOOM_BLUR_HLSL, "bloom blur",
+			(unsigned int)SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT },
+		{ &PostBloomCompositePixel, &PostBloomCompositePipeline, POST_BLOOM_COMPOSITE_HLSL, "bloom composite",
+			(unsigned int)BACK_BUFFER_FORMAT },
+		{ &PostBloomCompositeWidePixel, &PostBloomCompositeWidePipeline, POST_BLOOM_COMPOSITE_WIDE_HLSL,
+			"bloom composite (wide)", (unsigned int)BACK_BUFFER_FORMAT },
+	};
+	std::string log;
+	for (int index = 0; index < 4; ++index) {
+		const BloomBuild & build = builds[index];
+		if (*build.Shader == NULL) {
+			std::vector<unsigned char> spirv;
+			if (!SDL3_Compile_HLSL_To_SPIRV(build.Source, false, spirv, log)
+				|| (*build.Shader = SDL3_Create_Shader(GpuDevice, spirv, false, log)) == NULL) {
+				fprintf(stderr, "post: the %s program: %s\n", build.Name, log.c_str());
+				return false;
+			}
+		}
+		if (*build.Pipeline == NULL) {
+			SDL_GPUColorTargetDescription target;
+			SDL_zero(target);
+			target.format = (SDL_GPUTextureFormat)build.Format;
+			SDL_GPUGraphicsPipelineCreateInfo info;
+			SDL_zero(info);
+			info.vertex_shader = PostVertex;
+			info.fragment_shader = *build.Shader;
+			info.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+			info.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
+			info.rasterizer_state.cull_mode = SDL_GPU_CULLMODE_NONE;
+			info.target_info.color_target_descriptions = &target;
+			info.target_info.num_color_targets = 1;
+			*build.Pipeline = SDL_CreateGPUGraphicsPipeline(GpuDevice, &info);
+			if (*build.Pipeline == NULL) {
+				fprintf(stderr, "post: the %s pipeline: %s\n", build.Name, SDL_GetError());
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+// The chain passes' programs (v1.30 step 3): fxaa's and sharpen's, each built
+// on its own, for the effects the configured chain names.  Per-effect
+// isolation (committee Q1): a program that would not build costs its effect
+// only -- the reason goes on stderr, the rest of the chain runs.  The mask
+// returned names the effects that may run.  The pipelines write the
+// eight-bit targets the passes route through -- a chain target or the back
+// buffer, both BACK_BUFFER_FORMAT -- so they build against that, like the
+// composite's copy.
+// Step 4 adds AO's two bodies at the end, on the full tier only, with the
+// same isolation.  The scene body's pipelines write the scene target, so
+// they build against its two formats, with dx11post's multiply blend; the
+// finish body writes the eight-bit targets like the passes above.
+unsigned SdlGpuFrame::Create_Chain_Pipelines()
+{
+	struct ChainBuild {
+		SDL_GPUShader ** Shader;
+		SDL_GPUGraphicsPipeline ** Pipeline;
+		const char * Source;
+		const char * Name;
+		int Effect;
+	};
+	const ChainBuild builds[2] = {
+		{ &PostFxaaPixel, &PostFxaaPipeline, POST_FXAA_HLSL, "fxaa", SdlPostPlan::EFFECT_FXAA },
+		{ &PostSharpenPixel, &PostSharpenPipeline, POST_SHARPEN_HLSL, "sharpen", SdlPostPlan::EFFECT_SHARPEN },
+	};
+	unsigned mask = 0;
+	std::string log;
+	for (int index = 0; index < 2; ++index) {
+		const ChainBuild & build = builds[index];
+		bool wanted = false;
+		for (unsigned slot = 0; slot < PostChainLength; ++slot) {
+			if (PostChainEffects[slot] == build.Effect) {
+				wanted = true;
+			}
+		}
+		if (!wanted) {
+			continue;
+		}
+		if (*build.Shader == NULL) {
+			std::vector<unsigned char> spirv;
+			if (!SDL3_Compile_HLSL_To_SPIRV(build.Source, false, spirv, log)
+				|| (*build.Shader = SDL3_Create_Shader(GpuDevice, spirv, false, log)) == NULL) {
+				fprintf(stderr, "post: the %s program: %s; %s stays off, the chain runs without it\n",
+					build.Name, log.c_str(), build.Name);
+				continue;
+			}
+		}
+		if (*build.Pipeline == NULL) {
+			SDL_GPUColorTargetDescription target;
+			SDL_zero(target);
+			target.format = BACK_BUFFER_FORMAT;
+			SDL_GPUGraphicsPipelineCreateInfo info;
+			SDL_zero(info);
+			info.vertex_shader = PostVertex;
+			info.fragment_shader = *build.Shader;
+			info.vertex_input_state.num_vertex_buffers = 0;
+			info.vertex_input_state.num_vertex_attributes = 0;
+			info.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+			info.target_info.color_target_descriptions = &target;
+			info.target_info.num_color_targets = 1;
+			*build.Pipeline = SDL_CreateGPUGraphicsPipeline(GpuDevice, &info);
+			if (*build.Pipeline == NULL) {
+				fprintf(stderr, "post: the %s pipeline: %s; %s stays off, the chain runs without it\n",
+					build.Name, SDL_GetError(), build.Name);
+				continue;
+			}
+		}
+		mask |= SdlPostPlan::Effect_Bit(build.Effect);
+	}
+	// AO (v1.30 step 4): two bodies -- the scene one, which returns the
+	// multiply factor over a copy of the scene, and the finish one, which
+	// multiplies the scene itself when the mid-scene pass was refused.  The
+	// full tier only: off it AO is subtracted, and building its programs
+	// would be the subtraction's lie.  Each body builds on its own, as the
+	// chain's isolation asks; the bit names AO when either can run, and
+	// each use site checks its own pipelines.
+	if (PostTierState == SdlPostTier::TIER_FULL) {
+		bool wanted = false;
+		for (unsigned slot = 0; slot < PostChainLength; ++slot) {
+			if (PostChainEffects[slot] == SdlPostPlan::EFFECT_AO) {
+				wanted = true;
+			}
+		}
+		if (wanted) {
+			bool usable = false;
+			if (PostAoScenePixel == NULL) {
+				std::vector<unsigned char> spirv;
+				if (!SDL3_Compile_HLSL_To_SPIRV(POST_AO_SCENE_HLSL, false, spirv, log)
+					|| (PostAoScenePixel = SDL3_Create_Shader(GpuDevice, spirv, false, log)) == NULL) {
+					fprintf(stderr, "post: the ao (scene) program: %s; the mid-scene ao stays off\n", log.c_str());
+				}
+			}
+			if (PostAoScenePixel != NULL && (PostAoScenePipeline == NULL || PostAoScenePipeline8 == NULL)) {
+				// dx11post's multiply: the factor times the scene already
+				// there -- source zero, destination source colour; the
+				// destination's alpha kept (its ZERO/ONE alpha factors).
+				SDL_GPUColorTargetDescription target;
+				SDL_zero(target);
+				target.blend_state.enable_blend = true;
+				target.blend_state.src_color_blendfactor = SDL_GPU_BLENDFACTOR_ZERO;
+				target.blend_state.dst_color_blendfactor = SDL_GPU_BLENDFACTOR_SRC_COLOR;
+				target.blend_state.color_blend_op = SDL_GPU_BLENDOP_ADD;
+				target.blend_state.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ZERO;
+				target.blend_state.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+				target.blend_state.alpha_blend_op = SDL_GPU_BLENDOP_ADD;
+				SDL_GPUGraphicsPipelineCreateInfo info;
+				SDL_zero(info);
+				info.vertex_shader = PostVertex;
+				info.fragment_shader = PostAoScenePixel;
+				info.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+				info.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
+				info.rasterizer_state.cull_mode = SDL_GPU_CULLMODE_NONE;
+				info.target_info.color_target_descriptions = &target;
+				info.target_info.num_color_targets = 1;
+				if (PostAoScenePipeline == NULL) {
+					target.format = SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT;
+					PostAoScenePipeline = SDL_CreateGPUGraphicsPipeline(GpuDevice, &info);
+				}
+				if (PostAoScenePipeline8 == NULL) {
+					target.format = BACK_BUFFER_FORMAT;
+					PostAoScenePipeline8 = SDL_CreateGPUGraphicsPipeline(GpuDevice, &info);
+				}
+				if (PostAoScenePipeline == NULL || PostAoScenePipeline8 == NULL) {
+					fprintf(stderr, "post: the ao (scene) pipeline: %s; the mid-scene ao stays off on one scene format\n",
+						SDL_GetError());
+				}
+			}
+			if (PostAoScenePipeline != NULL || PostAoScenePipeline8 != NULL) {
+				usable = true;
+			}
+			if (PostAoPixel == NULL) {
+				std::vector<unsigned char> spirv;
+				if (!SDL3_Compile_HLSL_To_SPIRV(POST_AO_HLSL, false, spirv, log)
+					|| (PostAoPixel = SDL3_Create_Shader(GpuDevice, spirv, false, log)) == NULL) {
+					fprintf(stderr, "post: the ao (finish) program: %s; the finish ao stays off\n", log.c_str());
+				}
+			}
+			if (PostAoPixel != NULL && PostAoPipeline == NULL) {
+				SDL_GPUColorTargetDescription target;
+				SDL_zero(target);
+				target.format = BACK_BUFFER_FORMAT;
+				SDL_GPUGraphicsPipelineCreateInfo info;
+				SDL_zero(info);
+				info.vertex_shader = PostVertex;
+				info.fragment_shader = PostAoPixel;
+				info.vertex_input_state.num_vertex_buffers = 0;
+				info.vertex_input_state.num_vertex_attributes = 0;
+				info.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+				info.target_info.color_target_descriptions = &target;
+				info.target_info.num_color_targets = 1;
+				PostAoPipeline = SDL_CreateGPUGraphicsPipeline(GpuDevice, &info);
+				if (PostAoPipeline == NULL) {
+					fprintf(stderr, "post: the ao (finish) pipeline: %s; the finish ao stays off\n", SDL_GetError());
+				}
+			}
+			if (PostAoPipeline != NULL) {
+				usable = true;
+			}
+			if (usable) {
+				mask |= SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_AO);
+			}
+		}
+	}
+	return mask;
+}
+
+// The haze's program and pipelines (v1.30 step 4): one body, two pipelines
+// for the scene target's two formats, with dx11post's alpha blend -- the
+// layer over the ground already there, the destination's alpha kept (its
+// ZERO/ONE alpha factors).  Built on the full tier only, and on its own,
+// as the chain's isolation asks: a failure costs the haze alone.
+bool SdlGpuFrame::Create_Haze_Pipelines()
+{
+	if (PostHazePipeline != NULL && PostHazePipeline8 != NULL) {
+		return true;
+	}
+	if (PostVertex == NULL) {
+		// The composite's build makes the shared vertex program first; the
+		// haze is only ever asked for after it (Configure_Post's order).
+		return false;
+	}
+	std::string log;
+	if (PostHazePixel == NULL) {
+		std::vector<unsigned char> spirv;
+		if (!SDL3_Compile_HLSL_To_SPIRV(POST_HAZE_HLSL, false, spirv, log)
+			|| (PostHazePixel = SDL3_Create_Shader(GpuDevice, spirv, false, log)) == NULL) {
+			fprintf(stderr, "post: the haze program: %s; the haze stays off, the chain runs without it\n",
+				log.c_str());
+			return false;
+		}
+	}
+	SDL_GPUColorTargetDescription target;
+	SDL_zero(target);
+	target.blend_state.enable_blend = true;
+	target.blend_state.src_color_blendfactor = SDL_GPU_BLENDFACTOR_SRC_ALPHA;
+	target.blend_state.dst_color_blendfactor = SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
+	target.blend_state.color_blend_op = SDL_GPU_BLENDOP_ADD;
+	target.blend_state.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ZERO;
+	target.blend_state.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+	target.blend_state.alpha_blend_op = SDL_GPU_BLENDOP_ADD;
+	SDL_GPUGraphicsPipelineCreateInfo info;
+	SDL_zero(info);
+	info.vertex_shader = PostVertex;
+	info.fragment_shader = PostHazePixel;
+	info.primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+	info.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
+	info.rasterizer_state.cull_mode = SDL_GPU_CULLMODE_NONE;
+	info.target_info.color_target_descriptions = &target;
+	info.target_info.num_color_targets = 1;
+	if (PostHazePipeline == NULL) {
+		target.format = SDL_GPU_TEXTUREFORMAT_R16G16B16A16_FLOAT;
+		PostHazePipeline = SDL_CreateGPUGraphicsPipeline(GpuDevice, &info);
+	}
+	if (PostHazePipeline8 == NULL) {
+		target.format = BACK_BUFFER_FORMAT;
+		PostHazePipeline8 = SDL_CreateGPUGraphicsPipeline(GpuDevice, &info);
+	}
+	if (PostHazePipeline == NULL && PostHazePipeline8 == NULL) {
+		fprintf(stderr, "post: the haze pipeline: %s; the haze stays off, the chain runs without it\n",
+			SDL_GetError());
+		return false;
+	}
+	if (PostHazePipeline == NULL || PostHazePipeline8 == NULL) {
+		fprintf(stderr, "post: one of the haze pipelines would not build (%s); the haze runs on the other scene format only\n",
+			SDL_GetError());
+	}
+	return true;
+}
+
+void SdlGpuFrame::Release_Post_Pipelines()
+{
+	if (GpuDevice == NULL) {
+		return;
+	}
+	if (PostTonePipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostTonePipeline);
+	if (PostToneWidePipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostToneWidePipeline);
+	if (PostCopyPipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostCopyPipeline);
+	if (PostVertex != NULL) SDL_ReleaseGPUShader(GpuDevice, PostVertex);
+	if (PostTonePixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostTonePixel);
+	if (PostToneWidePixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostToneWidePixel);
+	if (PostCopyPixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostCopyPixel);
+	if (PostSampler != NULL) SDL_ReleaseGPUSampler(GpuDevice, PostSampler);
+	if (PostBloomExtractPipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostBloomExtractPipeline);
+	if (PostBloomBlurPipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostBloomBlurPipeline);
+	if (PostBloomCompositePipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostBloomCompositePipeline);
+	if (PostBloomCompositeWidePipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostBloomCompositeWidePipeline);
+	if (PostFxaaPipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostFxaaPipeline);
+	if (PostSharpenPipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostSharpenPipeline);
+	if (PostAoScenePipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostAoScenePipeline);
+	if (PostAoScenePipeline8 != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostAoScenePipeline8);
+	if (PostAoPipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostAoPipeline);
+	if (PostHazePipeline != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostHazePipeline);
+	if (PostHazePipeline8 != NULL) SDL_ReleaseGPUGraphicsPipeline(GpuDevice, PostHazePipeline8);
+	if (PostBloomExtractPixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostBloomExtractPixel);
+	if (PostBloomBlurPixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostBloomBlurPixel);
+	if (PostBloomCompositePixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostBloomCompositePixel);
+	if (PostBloomCompositeWidePixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostBloomCompositeWidePixel);
+	if (PostFxaaPixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostFxaaPixel);
+	if (PostSharpenPixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostSharpenPixel);
+	if (PostAoScenePixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostAoScenePixel);
+	if (PostAoPixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostAoPixel);
+	if (PostHazePixel != NULL) SDL_ReleaseGPUShader(GpuDevice, PostHazePixel);
+	PostTonePipeline = PostToneWidePipeline = PostCopyPipeline = NULL;
+	PostVertex = PostTonePixel = PostToneWidePixel = PostCopyPixel = NULL;
+	PostSampler = NULL;
+	PostBloomExtractPipeline = PostBloomBlurPipeline = NULL;
+	PostBloomCompositePipeline = PostBloomCompositeWidePipeline = NULL;
+	PostBloomExtractPixel = PostBloomBlurPixel = NULL;
+	PostBloomCompositePixel = PostBloomCompositeWidePixel = NULL;
+	PostFxaaPipeline = PostSharpenPipeline = NULL;
+	PostFxaaPixel = PostSharpenPixel = NULL;
+	PostAoScenePipeline = PostAoScenePipeline8 = PostAoPipeline = NULL;
+	PostHazePipeline = PostHazePipeline8 = NULL;
+	PostAoScenePixel = PostAoPixel = PostHazePixel = NULL;
+}
+
+void SdlGpuFrame::Fill_Post_Constants(float * constants, const SdlPostParameters & parameters, bool ungraded) const
+{
+	Fill_Pass_Constants(constants, BackWidth, BackHeight, 0.0f, 0.0f, parameters, ungraded);
+}
+
+// One pass's block, as dx11post's Draw_Pass fills it for every pass in the chain:
+// the texel size of the texture that pass SAMPLES (the scene for the extract and
+// the composite, a bloom target for a blur), the pass's blur step, and the same
+// tuning and grade tail.
+void SdlGpuFrame::Fill_Pass_Constants(float * constants, unsigned int source_width, unsigned int source_height,
+	float blur_x, float blur_y, const SdlPostParameters & parameters, bool ungraded) const
+{
+	memset(constants, 0, 52 * sizeof(float));
+	const float width = (float)source_width;
+	const float height = (float)source_height;
+	// TexelSize: one over the sampled texture's size, and its size.
+	constants[0] = 1.0f / width;
+	constants[1] = 1.0f / height;
+	constants[2] = width;
+	constants[3] = height;
+	// BlurDirection: this pass's blur step, in source texels; zero but for a blur.
+	constants[4] = blur_x;
+	constants[5] = blur_y;
+	// Tuning: the bloom threshold and intensity as stored, then the fork's knees.
+	constants[8] = parameters.BloomThreshold;
+	constants[9] = parameters.BloomIntensity;
+	constants[10] = POST_TONE_CURVE_KNEE;
+	constants[11] = POST_BLOOM_KNEE;
+	// WarpInfo: no warps -- they cannot be handed over yet (their setter's caller is
+	// behind the present gate) -- and the frame's aspect, as Draw_Pass writes it.
+	constants[12] = 0.0f;
+	constants[13] = (height > 0.0f) ? width / height : 1.0f;
+	// WarpCentre and WarpRing (16..47) stay zero.
+	// Grade: the game's amount (zero when ungraded), then the fork's constants.
+	constants[48] = ungraded ? 0.0f : parameters.GradeAmount;
+	constants[49] = POST_GRADE_CONTRAST;
+	constants[50] = POST_GRADE_SATURATION;
+	constants[51] = POST_GRADE_SPLIT;
+}
+
+// dx11post's Draw_Pass fill for an occlusion pass (v1.30 step 4): the tuning
+// is the near and far planes and the AO radius and spread, in place of the
+// bloom tuning.  The planes are dx11post's own constructor constants, set
+// from nowhere else in the fork; the radius and spread are its file
+// constants (AO_RADIUS and AO_SPREAD).
+static void Fill_Occlusion_Tuning(float * constants)
+{
+	constants[8] = 1.0f;		// NearPlane
+	constants[9] = 1200.0f;		// FarPlane
+	constants[10] = 14.0f;		// AO_RADIUS
+	constants[11] = 26.0f;		// AO_SPREAD
+}
+
+bool SdlGpuFrame::Run_Post_Chain(const SdlPostParameters & parameters)
+{
+	if (!PostArmed || SceneBuffer == NULL) {
+		return false;
+	}
+	if (PostResolved) {
+		return false;	// dx11post's Resolved: the first finish of the frame ran it
+	}
+	const SdlTarget target = TargetSet ? CurrentTarget : Back_Buffer_Target();
+	if (target.Colour != SceneBuffer) {
+		// The batch is not on the scene here, so a pass recorded now would run over
+		// the wrong picture.  Skipped, and said out loud -- never submitted on its
+		// own, which would run it against a stale buffer.
+		if (!PostTargetWarned) {
+			PostTargetWarned = true;
+			fprintf(stderr, "post: Finish_Scene away from the scene target; the composite is skipped this frame\n");
+		}
+		return false;
+	}
+	// The frame's steps (v1.30 step 3): SdlPostChainPlan's reading of the
+	// configured chain under the tier's decision -- the composite first when
+	// the tier runs it, then the chain's passes in its own order, each reading
+	// the previous step's target and the last one writing the back buffer.
+	// The passes ride the mask Configure_Post armed; a resize that lost the
+	// chain targets disarms them again (PostChainPassesArmed), and the
+	// composite, when there is one, runs alone.
+	// Step 4: the plan is read with this frame's occlusion in hand -- when
+	// the scene took its AO mid-scene the plan strips it (dx11post's
+	// Run_Chain); when it did not, the AO step runs here, over the depth the
+	// occlude moment resolved.
+	unsigned mask = PostEffectArmedMask;
+	if (!PostChainPassesArmed) {
+		mask &= ~(SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_COPY)
+			| SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_FXAA)
+			| SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_SHARPEN)
+			| SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_AO));
+	}
+	const SdlPostPlan::Plan steps = SdlPostPlan::Make_Plan(PostChainEffects, PostChainLength,
+		PostCompositeStep, mask, PostOccluded);
+	if (steps.Count == 0) {
+		// Nothing of the chain can run this frame: the scene stays unresolved
+		// and Present's bring-down (dx11post's Copy_Through) brings it down.
+		return false;
+	}
+	bool invalidated = false;
+	bool recorded_any = false;
+	for (unsigned step_index = 0; step_index < steps.Count; ++step_index) {
+		const SdlPostPlan::Step & step = steps.Steps[step_index];
+		if (!step.Composite) {
+			// One chain pass.  Its constants are Draw_Pass's per-pass fill --
+			// the texel size of the pass's own source (the full size, like
+			// every pass in this chain) and the frame's grade, which the fxaa
+			// and sharpen bodies do not read; their parameters live in the
+			// bodies themselves, as dx11post keeps them.  AO is the exception
+			// (step 4): it reads the depth the occlude moment resolved, and
+			// its Tuning is Draw_Pass's occlusion fill, not the bloom tuning.
+			if (step.Effect == SdlPostPlan::EFFECT_AO && PostDepthTexture == NULL) {
+				// No depth was resolved this frame -- the occlude moment
+				// never came (a pass mode that skips it) and none exists
+				// yet.  The step is skipped, and said out loud once.
+				static bool reported = false;
+				if (!reported) {
+					reported = true;
+					fprintf(stderr, "post: the finish ao has no resolved depth; the step is skipped\n");
+				}
+				continue;
+			}
+			Command pass_command;
+			memset(&pass_command, 0, sizeof(pass_command));
+			pass_command.IsPostChainPass = true;
+			pass_command.PostEffect = (uint32_t)step.Effect;
+			pass_command.PostSource = step.Source;
+			pass_command.PostDest = step.Destination;
+			pass_command.PostDestWidth = BackWidth;
+			pass_command.PostDestHeight = BackHeight;
+			Fill_Pass_Constants(pass_command.PostConstants, BackWidth, BackHeight,
+				0.0f, 0.0f, parameters, false);
+			if (step.Effect == SdlPostPlan::EFFECT_AO) {
+				pass_command.PostExtraTexture = PostDepthTexture;
+				Fill_Occlusion_Tuning(pass_command.PostConstants);
+			}
+			if (!invalidated) {
+				Invalidate_Water_Snapshots(BackBuffer, NULL);
+				invalidated = true;
+			}
+			Commands.push_back(pass_command);
+			recorded_any = true;
+			continue;
+		}
+		// Bloom first, when it is armed and the stored intensity asks for it
+		// (v1.30 step 2): dx11post's sequence, planned by SdlPostBloomPlan and
+		// recorded pass for pass -- the extract and the blur pairs into the bloom
+		// targets, then the composite below adds the glow.  An intensity of zero
+		// plans no passes: the composite alone, graded, which is dx11post's own
+		// answer (its tone branch) and step 1's behaviour everywhere else.
+		const unsigned int bloom_width = BackWidth / 4 > 0 ? BackWidth / 4 : 1;
+		const unsigned int bloom_height = BackHeight / 4 > 0 ? BackHeight / 4 : 1;
+		const SdlPostBloom::Plan plan = SdlPostBloom::Make_Plan(PostBloomArmed,
+			parameters.BloomIntensity, parameters.BloomBlurPasses, bloom_width, bloom_height);
+		for (unsigned index = 0; index < plan.Count; ++index) {
+			const SdlPostBloom::Pass & pass = plan.Passes[index];
+			Command bloom_command;
+			memset(&bloom_command, 0, sizeof(bloom_command));
+			bloom_command.IsPostBloomPass = true;
+			bloom_command.PostBloomExtract = pass.Extract;
+			bloom_command.PostSource = pass.Source;
+			bloom_command.PostDest = pass.Destination;
+			bloom_command.PostDestWidth = bloom_width;
+			bloom_command.PostDestHeight = bloom_height;
+			if (pass.Extract) {
+				Fill_Pass_Constants(bloom_command.PostConstants, BackWidth, BackHeight,
+					0.0f, 0.0f, parameters, false);
+			}
+			else {
+				Fill_Pass_Constants(bloom_command.PostConstants, bloom_width, bloom_height,
+					pass.BlurX, pass.BlurY, parameters, false);
+			}
+			Commands.push_back(bloom_command);
+		}
+		Command command;
+		memset(&command, 0, sizeof(command));
+		command.IsPostComposite = true;
+		command.PostWide = parameters.InternalHdr;
+		command.PostCopy = false;
+		command.PostBloom = plan.Glow;
+		command.PostSource = plan.GlowSource;
+		// The composite's destination comes from the chain plan (v1.30 step 3):
+		// the back buffer when it is the chain's last step, the first chain
+		// target when a pass follows it -- dx11post's not-alone routing.
+		command.PostDest = step.Destination;
+		Fill_Post_Constants(command.PostConstants, parameters, false);
+		if (!invalidated) {
+			Invalidate_Water_Snapshots(BackBuffer, NULL);
+			invalidated = true;
+		}
+		Commands.push_back(command);
+		recorded_any = true;
+	}
+	if (!recorded_any) {
+		// Every step was skipped (a finish AO with no resolved depth is the
+		// one such case): the scene stays unresolved and Present's
+		// bring-down brings it down, as an empty plan's frame does.
+		return false;
+	}
+	PostResolved = true;
+	return true;
+}
+
+
+// The mid-scene moment (v1.30 step 4): dx11post's Occlude_Scene and
+// Haze_Scene, sequenced as the Windows runtime sequences them -- the depth
+// resolved first, at this point of the batch, then the AO over the scene,
+// then the haze over that.  The depth is this backend's own snapshot,
+// resolved here every frame the passes can run: the water's snapshot is
+// frozen before the water draws and does not exist on a map with no water
+// (committee R11), and the AO keys on the depth of the finished world --
+// the translucent flush has landed, the particles have not drawn.
+bool SdlGpuFrame::Run_Post_Occlude(const SdlPostParameters & parameters,
+	const float world_from_clip[16], bool has_world)
+{
+	if (!PostArmed || SceneBuffer == NULL || !PostOccludeArmed) {
+		return false;
+	}
+	if (PostResolved) {
+		return false;	// dx11post's Resolved: the finish already ran this frame
+	}
+	const bool ao_wanted = !PostOccluded
+		&& (PostEffectArmedMask & SdlPostPlan::Effect_Bit(SdlPostPlan::EFFECT_AO)) != 0
+		&& (PostFloatScene ? PostAoScenePipeline : PostAoScenePipeline8) != NULL
+		&& PostSceneCopy != NULL;
+	const bool haze_wanted = !PostHazed && PostHazeArmed
+		&& parameters.HazeStrength > 0.0f && has_world
+		&& (PostFloatScene ? PostHazePipeline : PostHazePipeline8) != NULL;
+	if (!ao_wanted && !haze_wanted) {
+		return false;
+	}
+	if (PostDepthTexture == NULL || !DepthSampleable) {
+		return false;
+	}
+	// The depth, resolved at this point of the batch -- the Windows
+	// runtime's Resolve_Scene_Depth, which runs before the passes and
+	// whether or not they then refuse.  The resolve reads the scene's own
+	// depth attachment, whatever target the batch is on.
+	{
+		Command snapshot;
+		memset(&snapshot, 0, sizeof(snapshot));
+		snapshot.IsDepthSnapshot = true;
+		snapshot.PostDepthSnapshot = true;
+		snapshot.BlitSource = DepthStencil;
+		snapshot.BlitDestination = PostDepthTexture;
+		snapshot.Rect[2] = (int32_t)BackWidth;
+		snapshot.Rect[3] = (int32_t)BackHeight;
+		Commands.push_back(snapshot);
+	}
+	const SdlTarget target = TargetSet ? CurrentTarget : Back_Buffer_Target();
+	if (target.Colour != SceneBuffer) {
+		// The draws are not on the scene here, so a pass recorded now would
+		// run over the wrong picture (dx11post's scene-view guard).  The
+		// depth above still resolved, as his does.  Skipped, and said out
+		// loud once a frame, as the finish's skip is.
+		if (!PostOccludeWarned) {
+			PostOccludeWarned = true;
+			fprintf(stderr, "post: Occlude_Scene away from the scene target; the occlusion and the haze are skipped this frame\n");
+		}
+		return false;
+	}
+	bool drew = false;
+	if (ao_wanted) {
+		// The scene's copy first: the pass keys on the scene's colour and
+		// cannot read the target it multiplies (dx11post's SceneCopy).  The
+		// copy is recorded as the water's colour capture records its own:
+		// a plain blit, whole rectangles, nearest.
+		Command copy;
+		memset(&copy, 0, sizeof(copy));
+		copy.IsBlit = true;
+		copy.BlitSource = SceneBuffer;
+		copy.BlitDestination = PostSceneCopy;
+		copy.Rect[2] = (int32_t)BackWidth;
+		copy.Rect[3] = (int32_t)BackHeight;
+		copy.BlitRect[2] = (int32_t)BackWidth;
+		copy.BlitRect[3] = (int32_t)BackHeight;
+		copy.BlitLinear = false;
+		Commands.push_back(copy);
+		Command ao;
+		memset(&ao, 0, sizeof(ao));
+		ao.IsPostOccludePass = true;
+		ao.PostSourceTexture = PostSceneCopy;
+		ao.PostDestTexture = SceneBuffer;
+		ao.PostExtraTexture = PostDepthTexture;
+		ao.PostFloatDest = PostFloatScene;
+		ao.PostDestWidth = BackWidth;
+		ao.PostDestHeight = BackHeight;
+		Fill_Pass_Constants(ao.PostConstants, BackWidth, BackHeight, 0.0f, 0.0f, parameters, false);
+		Fill_Occlusion_Tuning(ao.PostConstants);
+		Commands.push_back(ao);
+		PostOccluded = true;
+		drew = true;
+	}
+	if (haze_wanted) {
+		// The shroud, translated through the device's mirror as a draw
+		// translates it: the terrain draws with it every frame, so its copy
+		// exists by now.  When none was set, or its copy cannot be had, the
+		// pass runs with the shroud's weight at zero -- dx11post's own
+		// answer to an unbound shroud (Draw_Pass writes the bound flag from
+		// the view's presence) -- said out loud when a set one was refused.
+		SDL_GPUTexture * shroud = NULL;
+		if (parameters.HazeShroud != NULL) {
+			shroud = Translate_Texture((void *)parameters.HazeShroud);
+			if (shroud == NULL) {
+				static bool reported = false;
+				if (!reported) {
+					reported = true;
+					fprintf(stderr, "post: the haze's shroud texture has no SDL copy; the haze runs unshrouded\n");
+				}
+			}
+		}
+		Command haze;
+		memset(&haze, 0, sizeof(haze));
+		haze.IsPostHazePass = true;
+		// The body never samples Source; the depth satisfies the
+		// declaration -- never the destination, which this pass is writing.
+		haze.PostSourceTexture = PostDepthTexture;
+		haze.PostDestTexture = SceneBuffer;
+		haze.PostExtraTexture = PostDepthTexture;
+		haze.PostShroudTexture = shroud != NULL ? shroud : PostDepthTexture;
+		haze.PostFloatDest = PostFloatScene;
+		haze.PostDestWidth = BackWidth;
+		haze.PostDestHeight = BackHeight;
+		Fill_Pass_Constants(haze.PostConstants, BackWidth, BackHeight, 0.0f, 0.0f, parameters, false);
+		// The block's tail, as Draw_Pass fills it: the haze's own fields,
+		// the world-from-clip, the sun with its z overwritten by the
+		// shroud-bound flag, and the shroud's rect.  The last four floats
+		// (WorldAoProjection) stay zero: they are the World AO's, and that
+		// pass is not this one.
+		float * tail = haze.PostConstantsTail;
+		tail[0] = parameters.HazeTop;
+		tail[1] = parameters.HazeThickness;
+		tail[2] = parameters.HazeStrength;
+		tail[3] = parameters.HazeReach;
+		tail[4] = parameters.HazeColour[0];
+		tail[5] = parameters.HazeColour[1];
+		tail[6] = parameters.HazeColour[2];
+		tail[7] = parameters.HazeWater;
+		memcpy(tail + 8, world_from_clip, 16 * sizeof(float));
+		tail[24] = parameters.HazeSun[0];
+		tail[25] = parameters.HazeSun[1];
+		tail[26] = shroud != NULL ? 1.0f : 0.0f;
+		tail[27] = parameters.HazeSun[3];
+		memcpy(tail + 28, parameters.HazeShroudRect, 4 * sizeof(float));
+		Commands.push_back(haze);
+		PostHazed = true;
+		drew = true;
+	}
+	return drew;
+}
+
+void SdlGpuFrame::Record_Bring_Down()
+{
+	Command command;
+	memset(&command, 0, sizeof(command));
+	command.IsPostComposite = true;
+	command.PostWide = false;
+	command.PostCopy = !PostFloatScene;
+	const SdlPostParameters none = { 0.0f, 0.0f, 1.0f, 0, 0.0f, false };
+	Fill_Post_Constants(command.PostConstants, none, true);
+	Invalidate_Water_Snapshots(BackBuffer, NULL);
+	Commands.push_back(command);
+	PostResolved = true;
+}
+
+bool SdlGpuFrame::Run_Post_Pass(SDL_GPUCommandBuffer * commands, const Command & command)
+{
+	{ static bool first = true; if (first) { first = false; fprintf(stderr, "[post] first composite pass\n"); } }
+	SDL_GPUTexture * glow = NULL;
+	if (command.PostBloom && !command.PostCopy) {
+		glow = (command.PostSource >= 1 && command.PostSource <= 2)
+			? BloomTargets[command.PostSource - 1] : NULL;
+	}
+	SDL_GPUGraphicsPipeline * pipeline = command.PostCopy ? PostCopyPipeline
+		: glow != NULL ? (command.PostWide ? PostBloomCompositeWidePipeline : PostBloomCompositePipeline)
+		: command.PostWide ? PostToneWidePipeline : PostTonePipeline;
+	// The composite's destination: the back buffer, or the first chain target
+	// when a chain pass follows it (step 3's not-alone routing).  A bring-down
+	// command names the back buffer, as it always has.
+	SDL_GPUTexture * destination = (command.PostDest == SdlPostPlan::TARGET_CHAIN_0)
+		? ChainTargets[0] : BackBuffer;
+	if (pipeline == NULL || SceneBuffer == NULL || PostSampler == NULL || destination == NULL) {
+		// Configure_Post arms only with its pipelines built; this is the belt over
+		// that brace.  The frame keeps its previous picture rather than none.
+		static bool reported = false;
+		if (!reported) {
+			reported = true;
+			fprintf(stderr, "post: the composite's pipeline is missing; the pass is skipped\n");
+		}
+		return true;
+	}
+	SDL_GPUColorTargetInfo colour;
+	SDL_zero(colour);
+	colour.texture = destination;
+	colour.load_op = SDL_GPU_LOADOP_DONT_CARE;
+	colour.store_op = SDL_GPU_STOREOP_STORE;
+	SDL_GPURenderPass * pass = SDL_BeginGPURenderPass(commands, &colour, 1, NULL);
+	if (pass == NULL) {
+		return false;
+	}
+	SDL_BindGPUGraphicsPipeline(pass, pipeline);
+	// The prologue declares Extra beside Source; the tone and copy bodies never
+	// sample it, and it is bound to the scene so the declaration is satisfied.
+	SDL_GPUTextureSamplerBinding bindings[2];
+	bindings[0].texture = SceneBuffer;
+	bindings[0].sampler = PostSampler;
+	// With a glow (step 2), Extra is the bloom target the composite adds; the
+	// bloom composite bodies sample it, the tone and copy bodies never do.
+	bindings[1].texture = glow != NULL ? glow : SceneBuffer;
+	bindings[1].sampler = PostSampler;
+	SDL_BindGPUFragmentSamplers(pass, 0, bindings, 2);
+	// This pass's own viewport at its own destination's size: the recorded draws
+	// carry a deliberate half-texel offset, and inheriting it would resample the
+	// whole frame half a pixel (committee R6).
+	const SDL_GPUViewport viewport = { 0.0f, 0.0f, (float)BackWidth, (float)BackHeight, 0.0f, 1.0f };
+	SDL_SetGPUViewport(pass, &viewport);
+	const SDL_Rect scissor = { 0, 0, (int)BackWidth, (int)BackHeight };
+	SDL_SetGPUScissor(pass, &scissor);
+	SDL_PushGPUFragmentUniformData(commands, 0, command.PostConstants, sizeof(command.PostConstants));
+	SDL_DrawGPUPrimitives(pass, 3, 1, 0, 0);
+	SDL_EndGPURenderPass(pass);
+	return true;
+}
+
+// One bloom pass at replay (v1.30 step 2): the extract reads the scene into the
+// first bloom target; a blur half-pass reads one bloom target into the other.
+// Its own viewport at its own destination's size -- the quarter-resolution
+// targets make the half-pixel law bite harder here than anywhere (committee R6).
+bool SdlGpuFrame::Run_Bloom_Pass(SDL_GPUCommandBuffer * commands, const Command & command)
+{
+	{ static bool first = true; if (first) { first = false; fprintf(stderr, "[post] first bloom pass\n"); } }
+	SDL_GPUGraphicsPipeline * pipeline = command.PostBloomExtract
+		? PostBloomExtractPipeline : PostBloomBlurPipeline;
+	SDL_GPUTexture * source = command.PostSource == 0 ? SceneBuffer
+		: (command.PostSource >= 1 && command.PostSource <= 2)
+			? BloomTargets[command.PostSource - 1] : NULL;
+	SDL_GPUTexture * destination = (command.PostDest >= 1 && command.PostDest <= 2)
+		? BloomTargets[command.PostDest - 1] : NULL;
+	if (pipeline == NULL || source == NULL || destination == NULL || PostSampler == NULL) {
+		// Configure_Post arms bloom only with its targets and programs in hand;
+		// this is the belt over that brace.  The composite then runs without
+		// this pass's glow rather than the frame losing its picture.
+		static bool reported = false;
+		if (!reported) {
+			reported = true;
+			fprintf(stderr, "post: a bloom pass's pipeline or target is missing; the pass is skipped\n");
+		}
+		return true;
+	}
+	SDL_GPUColorTargetInfo colour;
+	SDL_zero(colour);
+	colour.texture = destination;
+	colour.load_op = SDL_GPU_LOADOP_DONT_CARE;
+	colour.store_op = SDL_GPU_STOREOP_STORE;
+	SDL_GPURenderPass * pass = SDL_BeginGPURenderPass(commands, &colour, 1, NULL);
+	if (pass == NULL) {
+		return false;
+	}
+	SDL_BindGPUGraphicsPipeline(pass, pipeline);
+	// The prologue declares Extra beside Source; neither body samples it, and it
+	// is bound to the source so the declaration is satisfied -- never to the
+	// destination, which this pass is writing.
+	SDL_GPUTextureSamplerBinding bindings[2];
+	bindings[0].texture = source;
+	bindings[0].sampler = PostSampler;
+	bindings[1].texture = source;
+	bindings[1].sampler = PostSampler;
+	SDL_BindGPUFragmentSamplers(pass, 0, bindings, 2);
+	const SDL_GPUViewport viewport = { 0.0f, 0.0f, (float)command.PostDestWidth,
+		(float)command.PostDestHeight, 0.0f, 1.0f };
+	SDL_SetGPUViewport(pass, &viewport);
+	const SDL_Rect scissor = { 0, 0, (int)command.PostDestWidth, (int)command.PostDestHeight };
+	SDL_SetGPUScissor(pass, &scissor);
+	SDL_PushGPUFragmentUniformData(commands, 0, command.PostConstants, sizeof(command.PostConstants));
+	SDL_DrawGPUPrimitives(pass, 3, 1, 0, 0);
+	SDL_EndGPURenderPass(pass);
+	return true;
+}
+
+
+// One chain pass at replay (v1.30 step 3): fxaa, sharpen or copy, reading its
+// source (the scene or a chain target) and writing its destination (the other
+// chain target, or the back buffer for the chain's last step).  Its own
+// viewport at its own destination's size, like every post pass (committee R6).
+// Step 4 adds the finish AO: the same routing, with the resolved depth at
+// Extra, where the other bodies never look.
+bool SdlGpuFrame::Run_Chain_Pass(SDL_GPUCommandBuffer * commands, const Command & command)
+{
+	{ static bool first = true; if (first) { first = false; fprintf(stderr, "[post] first chain pass\n"); } }
+	SDL_GPUGraphicsPipeline * pipeline = command.PostEffect == (uint32_t)SdlPostPlan::EFFECT_FXAA
+		? PostFxaaPipeline
+		: command.PostEffect == (uint32_t)SdlPostPlan::EFFECT_SHARPEN ? PostSharpenPipeline
+		: command.PostEffect == (uint32_t)SdlPostPlan::EFFECT_AO ? PostAoPipeline
+		: command.PostEffect == (uint32_t)SdlPostPlan::EFFECT_COPY ? PostCopyPipeline : NULL;
+	SDL_GPUTexture * source = command.PostSource == SdlPostPlan::TARGET_CHAIN_0 ? ChainTargets[0]
+		: command.PostSource == SdlPostPlan::TARGET_CHAIN_1 ? ChainTargets[1] : SceneBuffer;
+	SDL_GPUTexture * destination = command.PostDest == SdlPostPlan::TARGET_CHAIN_0 ? ChainTargets[0]
+		: command.PostDest == SdlPostPlan::TARGET_CHAIN_1 ? ChainTargets[1] : BackBuffer;
+	if (pipeline == NULL || source == NULL || destination == NULL || PostSampler == NULL) {
+		// Configure_Post arms a pass only with its program built and its
+		// targets made; this is the belt over that brace.  The frame keeps
+		// the picture the earlier steps left rather than none.
+		static bool reported = false;
+		if (!reported) {
+			reported = true;
+			fprintf(stderr, "post: a chain pass's pipeline or target is missing; the pass is skipped\n");
+		}
+		return true;
+	}
+	SDL_GPUColorTargetInfo colour;
+	SDL_zero(colour);
+	colour.texture = destination;
+	colour.load_op = SDL_GPU_LOADOP_DONT_CARE;
+	colour.store_op = SDL_GPU_STOREOP_STORE;
+	SDL_GPURenderPass * pass = SDL_BeginGPURenderPass(commands, &colour, 1, NULL);
+	if (pass == NULL) {
+		return false;
+	}
+	SDL_BindGPUGraphicsPipeline(pass, pipeline);
+	// The prologue declares Extra beside Source; the fxaa, sharpen and copy
+	// bodies never sample it, and it is bound to the source so the
+	// declaration is satisfied -- never to the destination, which this pass
+	// is writing.  The finish AO (step 4) names its Extra outright: the
+	// depth the occlude moment resolved.
+	SDL_GPUTextureSamplerBinding bindings[2];
+	bindings[0].texture = source;
+	bindings[0].sampler = PostSampler;
+	bindings[1].texture = command.PostExtraTexture != NULL ? command.PostExtraTexture : source;
+	bindings[1].sampler = PostSampler;
+	SDL_BindGPUFragmentSamplers(pass, 0, bindings, 2);
+	const SDL_GPUViewport viewport = { 0.0f, 0.0f, (float)command.PostDestWidth,
+		(float)command.PostDestHeight, 0.0f, 1.0f };
+	SDL_SetGPUViewport(pass, &viewport);
+	const SDL_Rect scissor = { 0, 0, (int)command.PostDestWidth, (int)command.PostDestHeight };
+	SDL_SetGPUScissor(pass, &scissor);
+	SDL_PushGPUFragmentUniformData(commands, 0, command.PostConstants, sizeof(command.PostConstants));
+	SDL_DrawGPUPrimitives(pass, 3, 1, 0, 0);
+	SDL_EndGPURenderPass(pass);
+	return true;
+}
+
+// The AO pass at replay (v1.30 step 4): the scene copy read with the depth
+// the occlude moment resolved, the scene target multiplied by the occlusion
+// factor the body returns -- its pipeline carries dx11post's multiply blend,
+// and the destination is loaded, not cleared: the blend reads it.  Its own
+// viewport at the scene's size, like every post pass.
+bool SdlGpuFrame::Run_Occlude_Pass(SDL_GPUCommandBuffer * commands, const Command & command)
+{
+	{ static bool first = true; if (first) { first = false; fprintf(stderr, "[post] first occlude (ao) pass\n"); } }
+	SDL_GPUGraphicsPipeline * pipeline = command.PostFloatDest
+		? PostAoScenePipeline : PostAoScenePipeline8;
+	SDL_GPUTexture * source = command.PostSourceTexture;
+	SDL_GPUTexture * destination = command.PostDestTexture;
+	if (pipeline == NULL || source == NULL || destination == NULL
+		|| command.PostExtraTexture == NULL || PostSampler == NULL) {
+		// Configure_Post arms the pass only with its program built and its
+		// targets made; this is the belt over that brace.  The frame keeps
+		// the picture the world draws left rather than a wrong one.
+		static bool reported = false;
+		if (!reported) {
+			reported = true;
+			fprintf(stderr, "post: the ao pass's pipeline or target is missing; the pass is skipped\n");
+		}
+		return true;
+	}
+	SDL_GPUColorTargetInfo colour;
+	SDL_zero(colour);
+	colour.texture = destination;
+	colour.load_op = SDL_GPU_LOADOP_LOAD;
+	colour.store_op = SDL_GPU_STOREOP_STORE;
+	SDL_GPURenderPass * pass = SDL_BeginGPURenderPass(commands, &colour, 1, NULL);
+	if (pass == NULL) {
+		return false;
+	}
+	SDL_BindGPUGraphicsPipeline(pass, pipeline);
+	SDL_GPUTextureSamplerBinding bindings[2];
+	bindings[0].texture = source;
+	bindings[0].sampler = PostSampler;
+	bindings[1].texture = command.PostExtraTexture;
+	bindings[1].sampler = PostSampler;
+	SDL_BindGPUFragmentSamplers(pass, 0, bindings, 2);
+	const SDL_GPUViewport viewport = { 0.0f, 0.0f, (float)command.PostDestWidth,
+		(float)command.PostDestHeight, 0.0f, 1.0f };
+	SDL_SetGPUViewport(pass, &viewport);
+	const SDL_Rect scissor = { 0, 0, (int)command.PostDestWidth, (int)command.PostDestHeight };
+	SDL_SetGPUScissor(pass, &scissor);
+	SDL_PushGPUFragmentUniformData(commands, 0, command.PostConstants, sizeof(command.PostConstants));
+	SDL_DrawGPUPrimitives(pass, 3, 1, 0, 0);
+	SDL_EndGPURenderPass(pass);
+	return true;
+}
+
+// The haze pass at replay (v1.30 step 4): the resolved depth read back into
+// the world, the pale layer blended over the scene target -- loaded, not
+// cleared, as a blend pass must.  Its constants go at both fragment uniform
+// slots, the head at the first and the whole 88-float block at the second:
+// dx11post binds its one buffer at b0 and b1 both, and the haze body reads
+// its own fields from the second at the same offsets.
+bool SdlGpuFrame::Run_Haze_Pass(SDL_GPUCommandBuffer * commands, const Command & command)
+{
+	{ static bool first = true; if (first) { first = false; fprintf(stderr, "[post] first haze pass\n"); } }
+	SDL_GPUGraphicsPipeline * pipeline = command.PostFloatDest
+		? PostHazePipeline : PostHazePipeline8;
+	SDL_GPUTexture * destination = command.PostDestTexture;
+	if (pipeline == NULL || destination == NULL || command.PostSourceTexture == NULL
+		|| command.PostExtraTexture == NULL || command.PostShroudTexture == NULL
+		|| PostSampler == NULL) {
+		// Configure_Post arms the pass only with its program built and its
+		// targets made; this is the belt over that brace.
+		static bool reported = false;
+		if (!reported) {
+			reported = true;
