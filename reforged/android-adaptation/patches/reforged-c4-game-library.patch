diff --git a/GeneralsMD/Code/GameEngine/Include/Common/Monitors.h b/GeneralsMD/Code/GameEngine/Include/Common/Monitors.h
index 8daa1bec..69f42445 100644
--- a/GeneralsMD/Code/GameEngine/Include/Common/Monitors.h
+++ b/GeneralsMD/Code/GameEngine/Include/Common/Monitors.h
@@ -38,6 +38,7 @@
 #include <windows.h>
 #else
 #include <strings.h>
+#include <unistd.h>	// usleep, for the monitor re-read in listMonitors below
 #endif
 #include <stdlib.h>
 #include <string.h>
@@ -242,7 +243,29 @@ inline int listMonitors( MonitorEntry *entries, int capacity )
 		return 0;
 	if (ThePlatformDisplays != NULL)
 	{
-		const int count = ThePlatformDisplays->listMonitors( entries, capacity );
+		int count = ThePlatformDisplays->listMonitors( entries, capacity );
+		/* The floor below is a fiction for a run with no displays at all, and once it
+		 * escapes it is indistinguishable from a real 800x600 monitor: the display
+		 * mode, the first run's resolution and the options menu's list all take it
+		 * for the panel.  A platform whose video has only just started can answer
+		 * with no displays for the first instants of a cold start (device report,
+		 * 21/11/2026: whole sessions on an Android phone stretched from 800x600
+		 * over a 1640x720 panel, and an options save then wrote the size back to
+		 * Options.ini), so while a display table exists an empty or floor-sized
+		 * answer is re-read for up to about a second before it is believed.  A run
+		 * with no table at all (headless, the tests) keeps the floor at once, and
+		 * a real 800x600 monitor is believed as soon as the second is out. */
+		for (int attempt = 0; attempt < 100; ++attempt)
+		{
+			if (count > 1)
+				return count;
+			if (count == 1
+				&& (entries[0].rect.right - entries[0].rect.left != MIN_DISPLAY_MODE_WIDTH
+					|| entries[0].rect.bottom - entries[0].rect.top != MIN_DISPLAY_MODE_HEIGHT))
+				return count;
+			usleep( 10 * 1000 );
+			count = ThePlatformDisplays->listMonitors( entries, capacity );
+		}
 		if (count > 0)
 			return count;
 	}
