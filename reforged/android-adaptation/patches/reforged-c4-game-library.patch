+**	You should have received a copy of the GNU General Public License
+**	along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+/*
+** What the SDL GPU driver string says about the part, in one place (v1.30 step 1,
+** 2026-11-20).  The known-weak test started as SunShadow::WeakGpu's own parse
+** (PosixDevice9SunShadow.cpp); the post chain's tier gate (committee Q4) needs the
+** same answer, and two copies of the model list would drift.  The parse lives here;
+** WeakGpu keeps its signature, its caching and its log line, and asks this.
+**
+** The test is MODEL-aware, not family-wide (owner, 2026-11-20): Mali spans a decade
+** of parts, and the flagship Mali/Immortalis GPUs in Dimensity 8400-class SoCs and
+** above must never be capped by a rule written for the entry parts.  Weak means a
+** named entry part only -- Mali-Txxx (pre-G) or G31/G51/G52/G57/G310.  Any other
+** Mali (G68 and up, every G6xx/G7xx, Immortalis G9xx) and any Mali whose model
+** cannot be parsed keep full quality: the gate exists to help parts known to be
+** weak, and an unknown part is never capped on a guess.
+*/
+
+#pragma once
+
+#ifndef SDLGPUIDENTITY_H
+#define SDLGPUIDENTITY_H
+
+#include <stdlib.h>
+#include <string.h>
+
+namespace SdlGpuIdentity
+{
+	// True only for a named entry part in the driver string ("Mali-G52 MC2" on the
+	// reference phone).  A null or unparseable string is never weak.
+	inline bool Driver_Is_Known_Weak(const char * driver)
+	{
+		if (driver == NULL) {
+			return false;
+		}
+		const char * mali = strstr(driver, "Mali-");
+		if (mali == NULL) {
+			return false;
+		}
+		const char series = mali[5];
+		const int model = atoi(mali + 6);
+		if (series == 'T') {
+			return true;
+		}
+		return series == 'G' && (model == 31 || model == 51 || model == 52 || model == 57 || model == 310);
+	}
+
+	// Which string names the part: the device NAME when there is one (the
+	// Vulkan deviceName, "Mali-G52 MC2"), else the driver string.  The driver
+	// string alone is the SDL backend's name ("vulkan") and never carries a
+	// model -- the 1.30 device evidence (2026-11-21) is a Mali-G52 phone
+	// whose gates all read "vulkan", never fired, and took the full post
+	// tier.  Callers fetch SDL_PROP_GPU_DEVICE_NAME_STRING and pass both
+	// strings here so the choice lives in exactly one place.
+	inline bool Device_Is_Known_Weak(const char * device_name, const char * driver)
+	{
+		return Driver_Is_Known_Weak(device_name ? device_name : driver);
+	}
+}
+
+#endif // SDLGPUIDENTITY_H
