diff --git a/GeneralsMD/Code/GameEngine/Include/Common/GXControlScheme.h b/GeneralsMD/Code/GameEngine/Include/Common/GXControlScheme.h
new file mode 100644
index 00000000..8a20fc17
--- /dev/null
+++ b/GeneralsMD/Code/GameEngine/Include/Common/GXControlScheme.h
@@ -0,0 +1,93 @@
+/*
+**	Command & Conquer Generals Zero Hour(tm)
+**	Copyright 2025 Electronic Arts Inc.
