+		{ "GXForceAttack", 5, {
+			{ 4, { 28, 32, 32, 28 }, { 22, 22, 26, 26 } },
+			{ 3, { 30, 37, 23 }, { 18, 5, 5 } },
+			{ 3, { 30, 23, 37 }, { 30, 43, 43 } },
+			{ 3, { 22, 9, 9 }, { 24, 31, 17 } },
+			{ 3, { 38, 51, 51 }, { 24, 17, 31 } } } },
+		// Formation: two ranks of three, with the heading above them.
+		{ "GXFormation", 7, {
